import Math.LinearAlgebra as la

struct MetodoJacobi {
    Vector<double> x;
    double res;
    int iter;
}

struct MetodoPotencias {
    double vap;
    Vector<double> vep;
}

MetodoPotencias Potencias(Matrix<double> A, Vector<double, Column> x0, double tol, int maxiter) {
    Vector<double, Column> x = (1/la.norm(x0)) * x0;
    double vapOld = x' * A * x;
    int iter = 0;

    while (iter < maxiter) {
        Vector<double, Column> y = A * x;
        x = (1/la.norm(y)) * y;

        vap = x' * A * x;

        if (abs(vap - vapOld) < tol) {
            break;
        }

        vapOld = vap;

        iter += 1;
    }

    return MetodoPotencias(vapOld, x);
}

MetodoJacobi Jacobi(Matrix<double> A, Vector<double, Column> b, Vector<double, Column> x0, double tol, int maxiter) {
    int m = A.rows;
    int n = A.columns;

    Matrix<double> C = la.zeros(m, n);
    Matrix<double> D = la.zeros(m, n);

    for (int i in 1:m) {
        for (int j in 1:n) {
            if (i == j) {
                D[i, j] = A[i, j];
            } else {
                C[i, j] = A[i, j];
            }
        }
    }

    Vector<double, Column> x = x0;
    Vector<double, Column> c = b - C*x;
    double res = la.norm(D*x - c);
    int iter = 0;

    while (res > tol && iter < maxiter) {
        x = D \ c;
        res = la.norm(D*x - c);
        iter += 1;
    }

    return MetodoJacobi(x, res, iter);
}

int main() {
    Matrix<double> A = [1.0 2.0 3.0; 2.0 4.0 5.0; 3.0 5.0 6.0];
    Vector<double, Column> b = [4.0; 7.0; 3.0];
    Vector<double, Column> x0 = [1.0; 0.0; 0.0];

    MetodoPotencias potencias = Potencias(A, x0, 1e-8, 100);
    MetodoJacobi resultado = Jacobi(A, b, x0, 1e-8, 100);

    if (potencias.vap >= 1) {
        println("radio espectral: ", sqrt(potencias.vap));
        println("Jacobi puede no converger");
        println("Solution: ", resultado.x);
        println("Residual: ", resultado.res);
        println("Iterations: ", resultado.iter);
    } else {
        println("radio espectral: ", sqrt(potencias.vap));
        println("Jacobi converge");
        println("Solution: ", resultado.x);
        println("Residual: ", resultado.res);
        println("Iterations: ", resultado.iter);
    }

    return 0;
}
