{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aether",
  "scopeName": "source.aether",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#typeDeclarations" },
    { "include": "#functionDeclarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aether",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.line.number-sign.aether",
          "begin": "#",
          "end": "$"
        },
        {
          "name": "comment.block.aether",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aether",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aether",
          "match": "\\\\(?:[\"\\\\$ntr])"
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "match": "\\b(struct|class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.aether" },
            "2": { "name": "entity.name.type.aether" }
          }
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "match": "\\b(?:[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^>]+>)?)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.aether" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aether",
          "match": "\\b(?:if|else|while|for|in|return|break|continue|try|catch|throw)\\b"
        },
        {
          "name": "keyword.declaration.aether",
          "match": "\\b(?:alias|as|class|const|constructor|enum|from|function|implements|import|interface|package|private|public|static|struct)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.aether",
      "match": "\\b(?:int|float|double|complex|boolean|string|void|Array|List|Vector|Matrix|Error|ParseStatus|IntParseResult|DoubleParseResult|FileStatus|FileReadResult)\\b"
    },
    "constants": {
      "name": "constant.language.aether",
      "match": "\\b(?:true|false|null)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.aether",
      "match": "\\b(?:print|println|input)\\b(?=\\s*\\()"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aether",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+\\.[0-9]*(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.aether",
          "match": "(?<![A-Za-z0-9_])[0-9]+(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.aether",
      "match": "(?:\\.\\+|\\.-|\\.\\*|\\+=|==|!=|<=|>=|&&|\\|\\||[+\\-*/\\\\%^=!<>?:])"
    }
  }
}
