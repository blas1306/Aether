import Math.LinearAlgebra

Vector<double> f = input("Ingrese el sistema igualado a 0: ");
Matrix<double> jf = input("Ingrese la Jacobiana de dicho sistema: ");

public Vector<double> F(Vector<double> x) {
    mf = size(f)[0];
    for i in 0:(mf - 1) {
        f[i] = f[x[i]];
    }

    return f;
}

Vector<double> x0 = input("Ingrese un vector inicial: ");
double tol = 1e-8;
int maxiter = 100;

public (Vector<double> xn, double res, int iter) SNL(Vector<double> x0) {
    Vector<double> xn = x0;
    double res = norm(F(xn));
    int iter = 0;

    while (res > tol && iter < maxiter) {
        z = J_F(xn) \ (-F(xn));
        xn = xn + z;
        res = norm(F(xn));
        iter += 1;
    }

    return (xn, res, iter);
}

xn, res, iter = SNL(x0);

println("xn = ", xn);
println("res = ", res);
println("iter = ", iter);
