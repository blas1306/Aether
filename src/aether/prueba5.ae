import Math.LinearAlgebra

Vector<double> F(Vector<double> x) {
    return [x[0]^2 + x[1]^2 - 4, x[0] - x[1]];
}

Matrix<double> J_F(Vector<double> x) {
    return [2*x[0] 2*x[1]; 1 -1];
}

Vector<double> x0 = [1, 1];
double tol = 1e-8;
int maxiter = 100;

Vector<double> xn = x0;
double res = norm(F(xn));
int iter = 0;

while (res > tol && iter < maxiter) {
    z = J_F(xn) \ (-F(xn));
    xn = xn + z;
    res = norm(F(xn));
    iter += 1;
}

println("xn = ", xn);
println("res = ", res);
println("iter = ", iter);
