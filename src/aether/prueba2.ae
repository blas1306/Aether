f(x) = x^2 + 1;
println("f(4) = ", f(4));

boolean EsPrimo(int p) {
    for i in 2:int(sqrt(p)) {
        while (p % i == 0) {
            return false;
        }
        return true;
    }

    return true;
}

println(EsPrimo(5));

