import Math.LinearAlgebra

f(x) = x^2 + 1;
println("f(4) = ", f(4));

boolean EsPrimo(int p) {
    if p <= 1 {
        println("No existen numeros primos menores que 2");
    }

    if p == 2 {
        return true;
    }

    if p > 2 {
        for i in 2:int(sqrt(p)) {
            while (p % i == 0) {
            return false;
            }
        }
    }

    return true;
}

EsPrimo(1);
println(EsPrimo(2));
println(EsPrimo(5));
println(EsPrimo(57));

A = [3 2; 1 0; 0 0];
bb = [5, 3, 0];
b = transpose(bb);

m = rows(A);
n = cols(A);
x = A \ b;

println("Filas de A: ", m);
println("Columnas de A: ", n);
println("x = ", x);

double triple(double y) {
    return 3*y;
}

println(triple(3));

int numPrimos(int a) {
    return int(a*ln(a));
}

println(numPrimos(4));