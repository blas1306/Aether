package linearAlgebra;

// Runtime-shape constructors are ordinary generic overloads.  The expected
// result type selects the element type and, for vectors, the orientation.
public Matrix<T> zeros<T: Storable + Copy + Zero>(usize size) {
    return matrixFilled<T>(size, size, 0);
}

public Matrix<T> zeros<T: Storable + Copy + Zero>(usize rowCount, usize columnCount) {
    return matrixFilled<T>(rowCount, columnCount, 0);
}

public Vector<T,Row> zeros<T: Storable + Copy + Zero>(usize length) {
    return vectorFilled<T,Row>(length, 0);
}

public Vector<T,Column> zeros<T: Storable + Copy + Zero>(usize length) {
    return vectorFilled<T,Column>(length, 0);
}

public Matrix<T> ones<T: Storable + Copy + One>(usize size) {
    return matrixFilled<T>(size, size, 1);
}

public Matrix<T> ones<T: Storable + Copy + One>(usize rowCount, usize columnCount) {
    return matrixFilled<T>(rowCount, columnCount, 1);
}

public Vector<T,Row> ones<T: Storable + Copy + One>(usize length) {
    return vectorFilled<T,Row>(length, 1);
}

public Vector<T,Column> ones<T: Storable + Copy + One>(usize length) {
    return vectorFilled<T,Column>(length, 1);
}

public Matrix<T> identity<T: Storable + Copy + Zero + One>(usize size) {
    Matrix<T> result = zeros<T>(size, size);
    usize index = 1;
    while (index <= size) {
        result[index,index] = 1;
        index = index + 1;
    }
    return result;
}

// An economic LU factorization with a 1-based row permutation.  The
// permutation represents P directly: (P A)[i,j] = A[permutation[i],j].
public struct LU<T: Storable> {
    Vector<usize,Column> permutation;
    int permutationSign;
    Matrix<T> L;
    Matrix<T> U;
}

public class SingularMatrixException : Exception {
    public init() {}
}

Matrix<T> copyMatrixForFactorization<T: IEEEFloat>(ref Matrix<T> source) {
    usize m = rows(*source);
    usize n = columns(*source);
    Matrix<T> result = matrixFilled<T>(m, n, 0);
    usize i = 1;
    while (i <= m) {
        usize j = 1;
        while (j <= n) {
            result[i,j] = (*source)[i,j];
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

public LU<T> lu<T: IEEEFloat>(ref Matrix<T> A) {
    Matrix<T> workspace = copyMatrixForFactorization<T>(A);
    return luInPlace(workspace);
}

public LU<T> luInPlace<T: IEEEFloat>(Matrix<T> A) {
    T zero = 0;
    T one = 1;
    usize m = rows(A);
    usize n = columns(A);
    usize r = m;
    if (n < r) { r = n; }

    Vector<usize,Column> permutation = vectorFilled<usize,Column>(m, 0);
    usize i = 1;
    while (i <= m) {
        permutation[i] = i;
        i = i + 1;
    }
    int permutationSign = 1;

    usize k = 1;
    while (k <= r) {
        usize p = k;
        T best = abs(A[k,k]);
        i = k + 1;
        while (i <= m) {
            T magnitude = abs(A[i,k]);
            if (magnitude > best) {
                p = i;
                best = magnitude;
            }
            i = i + 1;
        }

        if (p != k) {
            usize j = 1;
            while (j <= n) {
                T temporary = A[k,j];
                A[k,j] = A[p,j];
                A[p,j] = temporary;
                j = j + 1;
            }
            usize permutationTemporary = permutation[k];
            permutation[k] = permutation[p];
            permutation[p] = permutationTemporary;
            permutationSign = -permutationSign;
        }

        if (A[k,k] != zero) {
            i = k + 1;
            while (i <= m) {
                A[i,k] = A[i,k] / A[k,k];
                usize j = k + 1;
                while (j <= n) {
                    A[i,j] = A[i,j] - A[i,k] * A[k,j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }

    if (m <= n) {
        Matrix<T> L = matrixFilled<T>(m, m, zero);
        i = 1;
        while (i <= m) {
            usize j = 1;
            while (j < i) {
                L[i,j] = A[i,j];
                A[i,j] = zero;
                j = j + 1;
            }
            L[i,i] = one;
            i = i + 1;
        }
        return LU<T>(permutation, permutationSign, L, A);
    }

    Matrix<T> U = matrixFilled<T>(n, n, zero);
    i = 1;
    while (i <= n) {
        usize j = i;
        while (j <= n) {
            U[i,j] = A[i,j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= m) {
        usize j = i + 1;
        while (j <= n) {
            A[i,j] = zero;
            j = j + 1;
        }
        if (i <= n) { A[i,i] = one; }
        i = i + 1;
    }
    return LU<T>(permutation, permutationSign, A, U);
}

public T det<T: IEEEFloat>(ref LU<T> factor) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));

    T result = 1;
    if ((*factor).permutationSign < 0) {
        result = -result;
    }
    usize i = 1;
    while (i <= rows((*factor).U)) {
        result = result * (*factor).U[i,i];
        i = i + 1;
    }
    return result;
}

public T det<T: IEEEFloat>(ref Matrix<T> A) {
    shapeGuard(rows(*A) == columns(*A));
    LU<T> factor = lu(A);
    return det(factor);
}

public T detInPlace<T: IEEEFloat>(Matrix<T> A) {
    shapeGuard(rows(A) == columns(A));
    LU<T> factor = luInPlace(A);
    return det(factor);
}

public Vector<T,Column> solve<T: IEEEFloat>(
    ref LU<T> factor,
    ref Vector<T,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    T zero = 0;
    usize n = rows((*factor).U);
    Vector<T,Column> w = vectorFilled<T,Column>(n, zero);
    usize i = 1;
    while (i <= n) {
        w[i] = (*b)[(*factor).permutation[i]];
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        T value = w[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        if ((*factor).U[i,i] == zero) {
            throw SingularMatrixException();
        }
        T value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).U[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).U[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

public Vector<T,Column> solve<T: IEEEFloat>(
    ref Matrix<T> A,
    ref Vector<T,Column> b) {
    shapeGuard(rows(*A) == columns(*A));
    shapeGuard(dimension(*b) == rows(*A));
    LU<T> factor = lu(A);
    return solve(factor, b);
}

public Vector<T,Column> solveInPlace<T: IEEEFloat>(
    Matrix<T> A,
    ref Vector<T,Column> b) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(dimension(*b) == rows(A));
    LU<T> factor = luInPlace(A);
    return solve(factor, b);
}

public Matrix<T> solve<T: IEEEFloat>(
    ref LU<T> factor,
    ref Matrix<T> B) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));
    shapeGuard(rows(*B) == rows((*factor).U));

    T zero = 0;
    usize n = rows((*factor).U);
    usize q = columns(*B);
    Matrix<T> W = matrixFilled<T>(n, q, zero);
    usize i = 1;
    while (i <= n) {
        usize c = 1;
        while (c <= q) {
            W[i,c] = (*B)[(*factor).permutation[i],c];
            c = c + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        usize j = 1;
        while (j < i) {
            T coefficient = (*factor).L[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        T diagonal = (*factor).U[i,i];
        if (diagonal == zero) {
            throw SingularMatrixException();
        }
        usize j = i + 1;
        while (j <= n) {
            T coefficient = (*factor).U[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        usize c = 1;
        while (c <= q) {
            W[i,c] = W[i,c] / diagonal;
            c = c + 1;
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return W;
}

public Matrix<T> solve<T: IEEEFloat>(
    ref Matrix<T> A,
    ref Matrix<T> B) {
    shapeGuard(rows(*A) == columns(*A));
    shapeGuard(rows(*B) == rows(*A));
    LU<T> factor = lu(A);
    return solve(factor, B);
}

public Matrix<T> solveInPlace<T: IEEEFloat>(
    Matrix<T> A,
    ref Matrix<T> B) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(rows(*B) == rows(A));
    LU<T> factor = luInPlace(A);
    return solve(factor, B);
}

// A lower-triangular Cholesky factor with A = L L^T.
public struct Cholesky<T: Storable> {
    Matrix<T> L;
}

public T det<T: IEEEFloat>(ref Cholesky<T> factor) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    usize n = rows((*factor).L);
    T p = 1;
    usize i = 1;
    while (i <= n) {
        p = p * (*factor).L[i,i];
        i = i + 1;
    }
    return p * p;
}

public class NotSymmetricMatrixException : Exception {
    public init() {}
}

public class NotPositiveDefiniteException : Exception {
    public init() {}
}

// Checked, in-place Cholesky factorization for the IEEE floating-point types.
public Cholesky<T> cholesky<T: IEEEFloat>(ref Matrix<T> A) {
    Matrix<T> workspace = copyMatrixForFactorization<T>(A);
    return choleskyInPlace(workspace);
}

// Checked, in-place Cholesky factorization for the IEEE floating-point types.
public Cholesky<T> choleskyInPlace<T: IEEEFloat>(Matrix<T> A) {
    shapeGuard(rows(A) == columns(A));

    T zero = 0;
    usize n = rows(A);
    usize i = 1;
    while (i <= n) {
        T diagonal = A[i,i];
        if (!((diagonal - diagonal) == zero)) {
            throw NotPositiveDefiniteException();
        }

        usize j = 1;
        while (j < i) {
            T lower = A[i,j];
            T upper = A[j,i];
            if (!((lower - lower) == zero)) {
                throw NotPositiveDefiniteException();
            }
            if (!((upper - upper) == zero)) {
                throw NotPositiveDefiniteException();
            }
            if (!(lower == upper)) {
                throw NotSymmetricMatrixException();
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        usize j = 1;
        while (j <= i) {
            T value = A[i,j];
            usize k = 1;
            while (k < j) {
                value = value - A[i,k] * A[j,k];
                k = k + 1;
            }

            if (i == j) {
                if (!((value - value) == zero) || !(value > zero)) {
                    throw NotPositiveDefiniteException();
                }
                A[i,i] = sqrt(value);
            }
            else {
                A[i,j] = value / A[j,j];
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        usize j = i + 1;
        while (j <= n) {
            A[i,j] = zero;
            j = j + 1;
        }
        i = i + 1;
    }
    return Cholesky<T>(A);
}

// Solve L L^T x = b using one owning result as both forward workspace and x.
public Vector<T,Column> solve<T: IEEEFloat>(
    ref Cholesky<T> factor,
    ref Vector<T,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    usize n = rows((*factor).L);
    T zero = 0;
    Vector<T,Column> w = vectorFilled<T,Column>(n, zero);
    usize i = 1;
    while (i <= n) {
        T value = (*b)[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).L[i,i];
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        T value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).L[j,i] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).L[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

// Solve L L^T X = B directly in one n by q owning result workspace.
public Matrix<T> solve<T: IEEEFloat>(
    ref Cholesky<T> factor,
    ref Matrix<T> B) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows(*B) == rows((*factor).L));

    usize n = rows((*factor).L);
    usize q = columns(*B);
    T zero = 0;
    Matrix<T> W = matrixFilled<T>(n, q, zero);
    usize i = 1;
    while (i <= n) {
        usize c = 1;
        while (c <= q) {
            T value = (*B)[i,c];
            usize j = 1;
            while (j < i) {
                value = value - (*factor).L[i,j] * W[j,c];
                j = j + 1;
            }
            W[i,c] = value / (*factor).L[i,i];
            c = c + 1;
        }
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        usize c = 1;
        while (c <= q) {
            T value = W[i,c];
            usize j = i + 1;
            while (j <= n) {
                value = value - (*factor).L[j,i] * W[j,c];
                j = j + 1;
            }
            W[i,c] = value / (*factor).L[i,i];
            c = c + 1;
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return W;
}

// A materialized QR factorization.  Q is m by m and R is m by n.
public struct QR<T: Storable> {
    Matrix<T> Q;
    Matrix<T> R;
}

// Private scaled sum-of-squares state shared by norm consumers.
struct StableScaledSquares<T: Storable> {
    T scale;
    T scaledSquares;
}

StableScaledSquares<T> stableScaledSquaresRange<T: IEEEFloat>(
    VectorView<T,Column> values,
    usize first,
    usize last) {
    T zero = 0;
    T one = 1;
    T scale = zero;
    T scaledSquares = one;

    usize i = first;
    while (i <= last) {
        T magnitude = abs(values[i]);

        if (magnitude != zero) {
            if (scale < magnitude) {
                T ratio = scale / magnitude;
                scaledSquares = one + scaledSquares * ratio * ratio;
                scale = magnitude;
            }
            else {
                T ratio = magnitude / scale;
                scaledSquares = scaledSquares + ratio * ratio;
            }
        }

        i = i + 1;
    }

    return StableScaledSquares<T>(scale, scaledSquares);
}

T finishStableNormNonzero<T: IEEEFloat>(StableScaledSquares<T> state) {
    return state.scale * sqrt(state.scaledSquares);
}

T stableNormRange<T: IEEEFloat>(
    VectorView<T,Column> values,
    usize first,
    usize last) {
    T zero = 0;
    StableScaledSquares<T> state =
        stableScaledSquaresRange<T>(values, first, last);
    if (state.scale == zero) {
        return zero;
    }
    return finishStableNormNonzero<T>(state);
}

T stableHypot<T: IEEEFloat>(T a, T b) {
    T zero = 0;
    T one = 1;

    T high = abs(a);
    T low = abs(b);

    if (high < low) {
        T temporary = high;
        high = low;
        low = temporary;
    }

    if (high == zero) {
        return zero;
    }

    T ratio = low / high;
    return high * sqrt(one + ratio * ratio);
}

// The public, preserving thin singular-value decomposition.
public struct SVD<T: Storable> {
    Matrix<T> U;
    Vector<T,Column> S;
    Matrix<T> Vt;
}

public class NonFiniteMatrixException : Exception {
    public init() {}
}

// This is the same nominal declaration introduced with bidiagonal QR.  SVD
// assembly promotes it instead of translating failures to another type.
public class NumericalConvergenceException : Exception {
    public init() {}
}

// Compact first phase of the future thin SVD.
// These implementation types and every kernel entry point remain private.
struct BidiagonalOrientation {
    bool transposed;
}

struct CompactBidiagonalReduction<T: Storable> {
    Matrix<T> workspace;
    Vector<T,Column> d;
    Vector<T,Column> e;
    Vector<T,Column> tauLeft;
    Vector<T,Column> tauRight;
    BidiagonalOrientation orientation;
}

struct BidiagonalSVDSeed<T: Storable> {
    Vector<T,Column> d;
    Vector<T,Column> e;
    Matrix<T> U;
    Matrix<T> Vt;
    BidiagonalOrientation orientation;
}

// Private scalar state for the implicit bidiagonal QR phase.  The converged
// aggregate is the ownership boundary used by the future public SVD assembly.
struct BidiagonalSVDConverged<T: Storable> {
    Vector<T,Column> d;
    Matrix<T> U;
    Matrix<T> Vt;
}

struct BidiagonalGivens<T: Storable> {
    T c;
    T s;
    T r;
}

struct BidiagonalShift<T: Storable> {
    T sigma;
    T lambda;
}

struct BidiagonalActiveBlock {
    bool active;
    usize lo;
    usize hi;
}

bool isFiniteInternal<T: IEEEFloat>(T value) {
    T zero = 0;
    return (value - value) == zero;
}

void requireFiniteInternal<T: IEEEFloat>(T value) {
    if (!isFiniteInternal<T>(value)) {
        throw NumericalConvergenceException();
    }
}

BidiagonalGivens<T> bidiagonalGivens<T: IEEEFloat>(T f, T g) {
    T zero = 0;
    T one = 1;
    T r = stableHypot<T>(f, g);
    requireFiniteInternal<T>(r);
    if (r == zero) {
        return BidiagonalGivens<T>(one, zero, r);
    }
    T c = f / r;
    T s = g / r;
    requireFiniteInternal<T>(c);
    requireFiniteInternal<T>(s);
    return BidiagonalGivens<T>(c, s, r);
}

void deflateBidiagonal<T: IEEEFloat>(
    ref Vector<T,Column> d,
    ref mut Vector<T,Column> e,
    T eps) {
    T zero = 0;
    usize i = 1;
    while (i <= dimension(*e)) {
        T a = abs((*d)[i]);
        T b = abs((*d)[i + 1]);
        T scale = a;
        if (scale < b) { scale = b; }

        T threshold = zero;
        if (scale != zero) {
            T normalizedSum = (a / scale) + (b / scale);
            threshold = (eps * scale) * normalizedSum;
        }
        if (abs((*e)[i]) <= threshold) {
            (*e)[i] = zero;
        }
        i = i + 1;
    }
}

BidiagonalActiveBlock selectBidiagonalBlock<T: IEEEFloat>(
    ref Vector<T,Column> d,
    ref Vector<T,Column> e) {
    T zero = 0;
    usize hi = dimension(*d);
    while (hi > 1 && (*e)[hi - 1] == zero) {
        hi = hi - 1;
    }
    if (hi == 1) {
        return BidiagonalActiveBlock(false, 1, 1);
    }
    usize lo = hi;
    while (lo > 1 && (*e)[lo - 1] != zero) {
        lo = lo - 1;
    }
    return BidiagonalActiveBlock(true, lo, hi);
}

BidiagonalShift<T> bidiagonalWilkinsonShift<T: IEEEFloat>(
    ref Vector<T,Column> d,
    ref Vector<T,Column> e,
    usize lo,
    usize hi) {
    T zero = 0;
    T one = 1;
    if ((*d)[hi] == zero) {
        return BidiagonalShift<T>(zero, zero);
    }

    T x = (*d)[hi - 1];
    T y = (*e)[hi - 1];
    T z = (*d)[hi];
    T w = zero;
    if (hi - 2 >= lo) { w = (*e)[hi - 2]; }
    T sigma = abs(x);
    if (sigma < abs(y)) { sigma = abs(y); }
    if (sigma < abs(z)) { sigma = abs(z); }
    if (sigma < abs(w)) { sigma = abs(w); }
    requireFiniteInternal<T>(sigma);

    T xn = x / sigma;
    T yn = y / sigma;
    T zn = z / sigma;
    T wn = w / sigma;
    requireFiniteInternal<T>(xn);
    requireFiniteInternal<T>(yn);
    requireFiniteInternal<T>(zn);
    requireFiniteInternal<T>(wn);

    T A = (xn * xn) + (wn * wn);
    T C = (zn * zn) + (yn * yn);
    T R = xn * yn;
    T delta = (A - C) / (one + one);
    T h = stableHypot<T>(delta, R);
    T denominator = abs(delta) + h;
    requireFiniteInternal<T>(A);
    requireFiniteInternal<T>(C);
    requireFiniteInternal<T>(R);
    requireFiniteInternal<T>(delta);
    requireFiniteInternal<T>(h);
    requireFiniteInternal<T>(denominator);

    T correction = zero;
    if (denominator != zero) {
        T magnitudeR = abs(R);
        correction = magnitudeR * (magnitudeR / denominator);
    }
    requireFiniteInternal<T>(correction);
    T lambda = C - correction;
    if (delta < zero) { lambda = C + correction; }
    if (lambda < zero) { lambda = zero; }
    requireFiniteInternal<T>(lambda);
    return BidiagonalShift<T>(sigma, lambda);
}

void rotateBidiagonalColumns<T: IEEEFloat>(
    ref mut Matrix<T> M,
    usize p,
    usize q,
    T c,
    T s) {
    usize r = 1;
    while (r <= rows(*M)) {
        T x = (*M)[r,p];
        T y = (*M)[r,q];
        T nextP = (c * x) + (s * y);
        T nextQ = (-s * x) + (c * y);
        requireFiniteInternal<T>(nextP);
        requireFiniteInternal<T>(nextQ);
        (*M)[r,p] = nextP;
        (*M)[r,q] = nextQ;
        r = r + 1;
    }
}

void rotateBidiagonalRows<T: IEEEFloat>(
    ref mut Matrix<T> M,
    usize p,
    usize q,
    T c,
    T s) {
    usize r = 1;
    while (r <= columns(*M)) {
        T x = (*M)[p,r];
        T y = (*M)[q,r];
        T nextP = (c * x) + (s * y);
        T nextQ = (-s * x) + (c * y);
        requireFiniteInternal<T>(nextP);
        requireFiniteInternal<T>(nextQ);
        (*M)[p,r] = nextP;
        (*M)[q,r] = nextQ;
        r = r + 1;
    }
}

void accumulateBidiagonalQ<T: IEEEFloat>(
    ref mut Matrix<T> U,
    ref mut Matrix<T> Vt,
    BidiagonalOrientation orientation,
    usize p,
    usize q,
    T c,
    T s) {
    if (orientation.transposed) {
        rotateBidiagonalColumns<T>(U, p, q, c, s);
    }
    else {
        rotateBidiagonalRows<T>(Vt, p, q, c, s);
    }
}

void accumulateBidiagonalP<T: IEEEFloat>(
    ref mut Matrix<T> U,
    ref mut Matrix<T> Vt,
    BidiagonalOrientation orientation,
    usize p,
    usize q,
    T c,
    T s) {
    if (orientation.transposed) {
        rotateBidiagonalRows<T>(Vt, p, q, c, s);
    }
    else {
        rotateBidiagonalColumns<T>(U, p, q, c, s);
    }
}

void chaseBidiagonalBulge<T: IEEEFloat>(
    ref mut Vector<T,Column> d,
    ref mut Vector<T,Column> e,
    ref mut Matrix<T> U,
    ref mut Matrix<T> Vt,
    BidiagonalOrientation orientation,
    usize start,
    usize hi,
    T firstC,
    T firstS) {
    T cRight = firstC;
    T sRight = firstS;
    T upperBulge = 0;
    usize p = start;
    while (p < hi) {
        if (p > start) {
            BidiagonalGivens<T> right =
                bidiagonalGivens<T>((*e)[p - 1], upperBulge);
            cRight = right.c;
            sRight = right.s;
            (*e)[p - 1] = right.r;
        }

        T oldD0 = (*d)[p];
        T oldE0 = (*e)[p];
        T oldD1 = (*d)[p + 1];
        T nextD0 = (cRight * oldD0) + (sRight * oldE0);
        T nextE0 = (-sRight * oldD0) + (cRight * oldE0);
        T lowerBulge = sRight * oldD1;
        T nextD1 = cRight * oldD1;
        requireFiniteInternal<T>(nextD0);
        requireFiniteInternal<T>(nextE0);
        requireFiniteInternal<T>(lowerBulge);
        requireFiniteInternal<T>(nextD1);
        (*d)[p] = nextD0;
        (*e)[p] = nextE0;
        (*d)[p + 1] = nextD1;
        accumulateBidiagonalQ<T>(U, Vt, orientation,
            p, p + 1, cRight, sRight);

        BidiagonalGivens<T> left =
            bidiagonalGivens<T>((*d)[p], lowerBulge);
        oldE0 = (*e)[p];
        oldD1 = (*d)[p + 1];
        nextE0 = (left.c * oldE0) + (left.s * oldD1);
        nextD1 = (-left.s * oldE0) + (left.c * oldD1);
        requireFiniteInternal<T>(nextE0);
        requireFiniteInternal<T>(nextD1);
        (*d)[p] = left.r;
        (*e)[p] = nextE0;
        (*d)[p + 1] = nextD1;

        if (p < hi - 1) {
            T oldE1 = (*e)[p + 1];
            upperBulge = left.s * oldE1;
            T nextE1 = left.c * oldE1;
            requireFiniteInternal<T>(upperBulge);
            requireFiniteInternal<T>(nextE1);
            (*e)[p + 1] = nextE1;
        }
        accumulateBidiagonalP<T>(U, Vt, orientation,
            p, p + 1, left.c, left.s);
        p = p + 1;
    }
}

void validateBidiagonalState<T: IEEEFloat>(
    ref Vector<T,Column> d,
    ref Vector<T,Column> e,
    ref Matrix<T> U,
    ref Matrix<T> Vt) {
    usize i = 1;
    while (i <= dimension(*d)) {
        requireFiniteInternal<T>((*d)[i]);
        i = i + 1;
    }
    i = 1;
    while (i <= dimension(*e)) {
        requireFiniteInternal<T>((*e)[i]);
        i = i + 1;
    }
    i = 1;
    while (i <= rows(*U)) {
        usize j = 1;
        while (j <= columns(*U)) {
            requireFiniteInternal<T>((*U)[i,j]);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= rows(*Vt)) {
        usize j = 1;
        while (j <= columns(*Vt)) {
            requireFiniteInternal<T>((*Vt)[i,j]);
            j = j + 1;
        }
        i = i + 1;
    }
}

int reduceTallBidiagonal<T: IEEEFloat>(
    MatrixViewMut<T> X,
    usize M,
    usize N,
    ref mut Vector<T,Column> d,
    ref mut Vector<T,Column> e,
    ref mut Vector<T,Column> tauLeft,
    ref mut Vector<T,Column> tauRight) {
    T zero = 0;
    T one = 1;
    usize i = 1;
    while (i <= N) {
        VectorView<T,Column> leftAxis = column(X,i);
        T leftNorm = stableNormRange<T>(leftAxis, i, M);
        T betaLeft = zero;
        T tauLeftValue = zero;
        if (leftNorm != zero) {
            betaLeft = leftNorm;
            if (X[i,i] >= zero) { betaLeft = -leftNorm; }
            T pivotRatio = X[i,i] / betaLeft;
            T denominatorRatio = pivotRatio - one;
            usize r = i + 1;
            while (r <= M) {
                X[r,i] = (X[r,i] / betaLeft) / denominatorRatio;
                r = r + 1;
            }
            tauLeftValue = one - pivotRatio;
        }
        (*d)[i] = betaLeft;
        (*tauLeft)[i] = tauLeftValue;
        X[i,i] = betaLeft;

        if (tauLeftValue != zero) {
            usize j = i + 1;
            while (j <= N) {
                T dot = X[i,j];
                usize r = i + 1;
                while (r <= M) {
                    dot = dot + X[r,i] * X[r,j];
                    r = r + 1;
                }
                T scale = tauLeftValue * dot;
                X[i,j] = X[i,j] - scale;
                r = i + 1;
                while (r <= M) {
                    X[r,j] = X[r,j] - scale * X[r,i];
                    r = r + 1;
                }
                j = j + 1;
            }
        }

        if (i < N) {
            VectorView<T,Row> rightRow = row(X,i);
            VectorView<T,Column> rightAxis = transpose_view(rightRow);
            T rightNorm = stableNormRange<T>(rightAxis, i + 1, N);
            T betaRight = zero;
            T tauRightValue = zero;
            if (rightNorm != zero) {
                betaRight = rightNorm;
                if (X[i,i + 1] >= zero) { betaRight = -rightNorm; }
                T pivotRatio = X[i,i + 1] / betaRight;
                T denominatorRatio = pivotRatio - one;
                usize c = i + 2;
                while (c <= N) {
                    X[i,c] = (X[i,c] / betaRight) / denominatorRatio;
                    c = c + 1;
                }
                tauRightValue = one - pivotRatio;
            }
            (*e)[i] = betaRight;
            (*tauRight)[i] = tauRightValue;
            X[i,i + 1] = betaRight;

            if (tauRightValue != zero) {
                usize r = i + 1;
                while (r <= M) {
                    T dot = X[r,i + 1];
                    usize c = i + 2;
                    while (c <= N) {
                        dot = dot + X[i,c] * X[r,c];
                        c = c + 1;
                    }
                    T scale = tauRightValue * dot;
                    X[r,i + 1] = X[r,i + 1] - scale;
                    c = i + 2;
                    while (c <= N) {
                        X[r,c] = X[r,c] - scale * X[i,c];
                        c = c + 1;
                    }
                    r = r + 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

CompactBidiagonalReduction<T> compactBidiagonalReduction<T: IEEEFloat>(
    Matrix<T> workspace) {
    T zero = 0;
    usize m = rows(workspace);
    usize n = columns(workspace);
    usize M = m;
    usize N = n;
    BidiagonalOrientation orientation = BidiagonalOrientation(false);
    if (m < n) {
        M = n;
        N = m;
        orientation = BidiagonalOrientation(true);
    }
    usize offDiagonal = 0;
    if (N > 0) { offDiagonal = N - 1; }
    Vector<T,Column> d = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> e = vectorFilled<T,Column>(offDiagonal, zero);
    Vector<T,Column> tauLeft = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> tauRight =
        vectorFilled<T,Column>(offDiagonal, zero);
    if (m < n) {
        reduceTallBidiagonal<T>(transpose_view_mut(workspace), M, N,
            &mut d, &mut e, &mut tauLeft, &mut tauRight);
    }
    else {
        reduceTallBidiagonal<T>(matrix_view_mut(workspace), M, N,
            &mut d, &mut e, &mut tauLeft, &mut tauRight);
    }
    return CompactBidiagonalReduction<T>(
        workspace, d, e, tauLeft, tauRight, orientation);
}

Matrix<T> materializeBidiagonalUpperU<T: IEEEFloat>(
    ref Matrix<T> workspace,
    ref Vector<T,Column> tauLeft) {
    T zero = 0;
    T one = 1;
    usize M = rows(*workspace);
    usize N = columns(*workspace);
    Matrix<T> U = matrixFilled<T>(M, N, zero);
    usize c = 1;
    while (c <= N) {
        U[c,c] = one;
        c = c + 1;
    }

    usize i = N;
    while (i > 0) {
        T tau = (*tauLeft)[i];
        if (tau != zero) {
            c = i;
            while (c <= N) {
                T dot = U[i,c];
                usize r = i + 1;
                while (r <= M) {
                    dot = dot + (*workspace)[r,i] * U[r,c];
                    r = r + 1;
                }
                T scale = tau * dot;
                U[i,c] = U[i,c] - scale;
                r = i + 1;
                while (r <= M) {
                    U[r,c] = U[r,c] -
                        scale * (*workspace)[r,i];
                    r = r + 1;
                }
                c = c + 1;
            }
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return U;
}

Matrix<T> materializeBidiagonalUpperVt<T: IEEEFloat>(
    ref Matrix<T> workspace,
    ref Vector<T,Column> tauRight) {
    T zero = 0;
    T one = 1;
    usize N = columns(*workspace);
    Matrix<T> Vt = matrixFilled<T>(N, N, zero);
    usize c = 1;
    while (c <= N) {
        Vt[c,c] = one;
        c = c + 1;
    }

    usize i = 1;
    while (i < N) {
        T tau = (*tauRight)[i];
        if (tau != zero) {
            c = 1;
            while (c <= N) {
                T dot = Vt[i + 1,c];
                usize r = i + 2;
                while (r <= N) {
                    dot = dot + (*workspace)[i,r] * Vt[r,c];
                    r = r + 1;
                }
                T scale = tau * dot;
                Vt[i + 1,c] = Vt[i + 1,c] - scale;
                r = i + 2;
                while (r <= N) {
                    Vt[r,c] = Vt[r,c] -
                        scale * (*workspace)[i,r];
                    r = r + 1;
                }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return Vt;
}

Matrix<T> materializeBidiagonalTransposedU<T: IEEEFloat>(
    ref Matrix<T> workspace,
    ref Vector<T,Column> tauRight) {
    T zero = 0;
    T one = 1;
    usize N = rows(*workspace);
    Matrix<T> U = matrixFilled<T>(N, N, zero);
    usize r = 1;
    while (r <= N) {
        U[r,r] = one;
        r = r + 1;
    }

    usize i = 1;
    while (i < N) {
        T tau = (*tauRight)[i];
        if (tau != zero) {
            r = 1;
            while (r <= N) {
                T dot = U[r,i + 1];
                usize c = i + 2;
                while (c <= N) {
                    dot = dot + U[r,c] * (*workspace)[c,i];
                    c = c + 1;
                }
                T scale = tau * dot;
                U[r,i + 1] = U[r,i + 1] - scale;
                c = i + 2;
                while (c <= N) {
                    U[r,c] = U[r,c] -
                        scale * (*workspace)[c,i];
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        i = i + 1;
    }
    return U;
}

Matrix<T> materializeBidiagonalTransposedVt<T: IEEEFloat>(
    ref Matrix<T> workspace,
    ref Vector<T,Column> tauLeft) {
    T zero = 0;
    T one = 1;
    usize N = rows(*workspace);
    usize M = columns(*workspace);
    Matrix<T> Vt = matrixFilled<T>(N, M, zero);
    usize c = 1;
    while (c <= N) {
        Vt[c,c] = one;
        c = c + 1;
    }

    usize i = N;
    while (i > 0) {
        T tau = (*tauLeft)[i];
        if (tau != zero) {
            usize r = i;
            while (r <= N) {
                T dot = Vt[r,i];
                c = i + 1;
                while (c <= M) {
                    dot = dot + Vt[r,c] * (*workspace)[i,c];
                    c = c + 1;
                }
                T scale = tau * dot;
                Vt[r,i] = Vt[r,i] - scale;
                c = i + 1;
                while (c <= M) {
                    Vt[r,c] = Vt[r,c] -
                        scale * (*workspace)[i,c];
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return Vt;
}

BidiagonalSVDSeed<T> bidiagonalSVDSeedInPlace<T: IEEEFloat>(
    Matrix<T> workspace) {
    T zero = 0;
    usize m = rows(workspace);
    usize n = columns(workspace);
    usize M = m;
    usize N = n;
    if (m < n) {
        M = n;
        N = m;
    }
    usize offDiagonal = 0;
    if (N > 0) { offDiagonal = N - 1; }
    Vector<T,Column> d = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> e = vectorFilled<T,Column>(offDiagonal, zero);
    Vector<T,Column> tauLeft = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> tauRight =
        vectorFilled<T,Column>(offDiagonal, zero);

    if (m < n) {
        // The only wide-only object is this O(1) transposed descriptor.
        reduceTallBidiagonal<T>(transpose_view_mut(workspace), M, N,
            &mut d, &mut e, &mut tauLeft, &mut tauRight);
        Matrix<T> U =
            materializeBidiagonalTransposedU<T>(&workspace, &tauRight);
        Matrix<T> Vt =
            materializeBidiagonalTransposedVt<T>(&workspace, &tauLeft);
        return BidiagonalSVDSeed<T>(
            d, e, U, Vt, BidiagonalOrientation(true));
    }

    reduceTallBidiagonal<T>(matrix_view_mut(workspace), M, N,
        &mut d, &mut e, &mut tauLeft, &mut tauRight);
    Matrix<T> U = materializeBidiagonalUpperU<T>(&workspace, &tauLeft);
    Matrix<T> Vt = materializeBidiagonalUpperVt<T>(&workspace, &tauRight);
    return BidiagonalSVDSeed<T>(
        d, e, U, Vt, BidiagonalOrientation(false));
}

BidiagonalSVDSeed<T> bidiagonalSVDSeed<T: IEEEFloat>(ref Matrix<T> A) {
    Matrix<T> workspace = copyMatrixForFactorization<T>(A);
    return bidiagonalSVDSeedInPlace<T>(workspace);
}

void convergeBidiagonalSVDState<T: IEEEFloat>(
    ref mut Vector<T,Column> d,
    ref mut Vector<T,Column> e,
    ref mut Matrix<T> U,
    ref mut Matrix<T> Vt,
    BidiagonalOrientation orientation,
    usize maxSteps) {
    T zero = 0;
    usize k = dimension(*d);
    if (k == 0 || k == 1) { return; }

    T eps = epsilon<T>();
    usize usedSteps = 0;
    while (true) {
        deflateBidiagonal<T>(&*d, e, eps);
        BidiagonalActiveBlock block =
            selectBidiagonalBlock<T>(&*d, &*e);
        if (!block.active) {
            usize finished = 1;
            while (finished <= dimension(*e)) {
                if ((*e)[finished] != zero) {
                    throw NumericalConvergenceException();
                }
                (*e)[finished] = zero;
                finished = finished + 1;
            }
            return;
        }
        if (usedSteps == maxSteps) {
            throw NumericalConvergenceException();
        }

        usize j = block.hi - 1;
        bool foundZero = false;
        while (true) {
            if ((*d)[j] == zero) {
                foundZero = true;
                break;
            }
            if (j == block.lo) { break; }
            j = j - 1;
        }

        if (foundZero) {
            BidiagonalGivens<T> initial =
                bidiagonalGivens<T>((*d)[j], (*e)[j]);
            chaseBidiagonalBulge<T>(
                d, e, U, Vt, orientation, j, block.hi,
                initial.c, initial.s);
            (*e)[block.hi - 1] = zero;
        }
        else {
            BidiagonalShift<T> shift = bidiagonalWilkinsonShift<T>(
                &*d, &*e, block.lo, block.hi);
            T t = abs((*d)[block.lo]);
            if (t < abs((*e)[block.lo])) {
                t = abs((*e)[block.lo]);
            }
            if (t < shift.sigma) { t = shift.sigma; }
            requireFiniteInternal<T>(t);
            T dn = (*d)[block.lo] / t;
            T en = (*e)[block.lo] / t;
            T sn = shift.sigma / t;
            T f = (dn * dn) - ((sn * sn) * shift.lambda);
            T g = dn * en;
            requireFiniteInternal<T>(dn);
            requireFiniteInternal<T>(en);
            requireFiniteInternal<T>(sn);
            requireFiniteInternal<T>(f);
            requireFiniteInternal<T>(g);
            BidiagonalGivens<T> initial = bidiagonalGivens<T>(f, g);
            chaseBidiagonalBulge<T>(
                d, e, U, Vt, orientation, block.lo, block.hi,
                initial.c, initial.s);
        }

        usedSteps = usedSteps + 1;
        validateBidiagonalState<T>(&*d, &*e, &*U, &*Vt);
        deflateBidiagonal<T>(&*d, e, eps);
    }
}

void convergeBidiagonalSVDSeed<T: IEEEFloat>(
    ref mut BidiagonalSVDSeed<T> seed,
    usize maxSteps) {
    convergeBidiagonalSVDState<T>(
        &mut (*seed).d, &mut (*seed).e,
        &mut (*seed).U, &mut (*seed).Vt,
        (*seed).orientation, maxSteps);
}

BidiagonalSVDSeed<T> bidiagonalSVDQRWithMaxSteps<T: IEEEFloat>(
    BidiagonalSVDSeed<T> seed,
    usize maxSteps) {
    convergeBidiagonalSVDSeed<T>(&mut seed, maxSteps);
    return seed;
}

BidiagonalSVDSeed<T> bidiagonalSVDQR<T: IEEEFloat>(
    BidiagonalSVDSeed<T> seed) {
    usize k = dimension(seed.d);
    if (k == 0 || k == 1) { return seed; }
    usize maxSteps = 64 * (k * k);
    convergeBidiagonalSVDSeed<T>(&mut seed, maxSteps);
    return seed;
}

// Exact ownership boundary used once a caller already owns the seed parts.
// The local e owner is destroyed on return; d/U/Vt move into the result.
BidiagonalSVDConverged<T> bidiagonalSVDQR<T: IEEEFloat>(
    Vector<T,Column> d,
    Vector<T,Column> e,
    Matrix<T> U,
    Matrix<T> Vt,
    BidiagonalOrientation orientation) {
    usize k = dimension(d);
    if (k > 1) {
        usize maxSteps = 64 * (k * k);
        convergeBidiagonalSVDState<T>(
            &mut d, &mut e, &mut U, &mut Vt,
            orientation, maxSteps);
    }
    return BidiagonalSVDConverged<T>(d, U, Vt);
}

void validateFiniteSVDInput<T: IEEEFloat>(ref Matrix<T> A) {
    usize i = 1;
    while (i <= rows(*A)) {
        usize j = 1;
        while (j <= columns(*A)) {
            if (!isFiniteInternal<T>((*A)[i,j])) {
                throw NonFiniteMatrixException();
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

void normalizeAndSortSVD<T: IEEEFloat>(
    ref mut Vector<T,Column> S,
    ref mut Matrix<T> U,
    ref mut Matrix<T> Vt) {
    T zero = 0;
    usize k = dimension(*S);

    // A negative diagonal changes sign together with its right singular
    // vector.  Equality also catches -0 and writes the canonical +0.
    usize i = 1;
    while (i <= k) {
        if ((*S)[i] < zero) {
            (*S)[i] = -(*S)[i];
            usize column = 1;
            while (column <= columns(*Vt)) {
                (*Vt)[i,column] = -(*Vt)[i,column];
                column = column + 1;
            }
        }
        if ((*S)[i] == zero) {
            (*S)[i] = zero;
        }
        i = i + 1;
    }

    // Stable descending bubble sort.  Strict comparison leaves equal
    // triplets in the exact order produced by bidiagonal QR.
    usize unsorted = k;
    while (unsorted > 1) {
        usize p = 1;
        while (unsorted > p) {
            if ((*S)[p + 1] > (*S)[p]) {
                T temporaryS = (*S)[p];
                (*S)[p] = (*S)[p + 1];
                (*S)[p + 1] = temporaryS;

                usize row = 1;
                while (row <= rows(*U)) {
                    T temporaryU = (*U)[row,p];
                    (*U)[row,p] = (*U)[row,p + 1];
                    (*U)[row,p + 1] = temporaryU;
                    row = row + 1;
                }

                usize column = 1;
                while (column <= columns(*Vt)) {
                    T temporaryVt = (*Vt)[p,column];
                    (*Vt)[p,column] = (*Vt)[p + 1,column];
                    (*Vt)[p + 1,column] = temporaryVt;
                    column = column + 1;
                }
            }
            p = p + 1;
        }
        unsorted = unsorted - 1;
    }
}

void validateFiniteSVDResult<T: IEEEFloat>(
    ref Vector<T,Column> S,
    ref Matrix<T> U,
    ref Matrix<T> Vt) {
    usize i = 1;
    while (i <= dimension(*S)) {
        if (!isFiniteInternal<T>((*S)[i])) {
            throw NumericalConvergenceException();
        }
        i = i + 1;
    }
    i = 1;
    while (i <= rows(*U)) {
        usize j = 1;
        while (j <= columns(*U)) {
            if (!isFiniteInternal<T>((*U)[i,j])) {
                throw NumericalConvergenceException();
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= rows(*Vt)) {
        usize j = 1;
        while (j <= columns(*Vt)) {
            if (!isFiniteInternal<T>((*Vt)[i,j])) {
                throw NumericalConvergenceException();
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

SVD<T> assembleBidiagonalSVD<T: IEEEFloat>(
    Vector<T,Column> d,
    Vector<T,Column> e,
    Matrix<T> U,
    Matrix<T> Vt,
    BidiagonalOrientation orientation) {
    usize k = dimension(d);
    if (k > 1) {
        usize maxSteps = 64 * (k * k);
        convergeBidiagonalSVDState<T>(
            &mut d, &mut e, &mut U, &mut Vt,
            orientation, maxSteps);
    }
    normalizeAndSortSVD<T>(&mut d, &mut U, &mut Vt);
    validateFiniteSVDResult<T>(&d, &U, &Vt);
    return SVD<T>(U, d, Vt);
}

SVD<T> assembleSVDWorkspace<T: IEEEFloat>(Matrix<T> workspace) {
    // Keep the seed parts as separate owners.  Aether deliberately rejects
    // partial moves out of structs, so this route feeds those exact owners to
    // the already-qualified reduction and convergence kernels and can finally
    // move d directly into the public S field.
    T zero = 0;
    usize m = rows(workspace);
    usize n = columns(workspace);
    usize M = m;
    usize N = n;
    BidiagonalOrientation orientation = BidiagonalOrientation(false);
    if (m < n) {
        M = n;
        N = m;
        orientation = BidiagonalOrientation(true);
    }
    usize offDiagonal = 0;
    if (N > 0) { offDiagonal = N - 1; }
    Vector<T,Column> d = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> e = vectorFilled<T,Column>(offDiagonal, zero);
    Vector<T,Column> tauLeft = vectorFilled<T,Column>(N, zero);
    Vector<T,Column> tauRight =
        vectorFilled<T,Column>(offDiagonal, zero);

    if (orientation.transposed) {
        reduceTallBidiagonal<T>(transpose_view_mut(workspace), M, N,
            &mut d, &mut e, &mut tauLeft, &mut tauRight);
        Matrix<T> U =
            materializeBidiagonalTransposedU<T>(&workspace, &tauRight);
        Matrix<T> Vt =
            materializeBidiagonalTransposedVt<T>(&workspace, &tauLeft);
        return assembleBidiagonalSVD<T>(d, e, U, Vt, orientation);
    }

    reduceTallBidiagonal<T>(matrix_view_mut(workspace), M, N,
        &mut d, &mut e, &mut tauLeft, &mut tauRight);
    Matrix<T> U = materializeBidiagonalUpperU<T>(&workspace, &tauLeft);
    Matrix<T> Vt = materializeBidiagonalUpperVt<T>(&workspace, &tauRight);
    return assembleBidiagonalSVD<T>(d, e, U, Vt, orientation);
}

public SVD<T> svd<T: IEEEFloat>(ref Matrix<T> A) {
    // This is the sole preserving copy.  It copies logical elements into the
    // normalized owning Matrix layout shared by the other factorizations.
    Matrix<T> workspace = copyMatrixForFactorization<T>(A);
    validateFiniteSVDInput<T>(&workspace);
    return assembleSVDWorkspace<T>(workspace);
}

public class RankDeficientMatrixException : Exception {
    public init() {}
}

// Solve the square or tall full-column-rank system represented by Q R.
public Vector<T,Column> solve<T: IEEEFloat>(
    ref QR<T> factor,
    ref Vector<T,Column> b) {
    shapeGuard(rows((*factor).Q) == columns((*factor).Q));
    shapeGuard(rows((*factor).R) == rows((*factor).Q));
    shapeGuard(rows((*factor).R) >= columns((*factor).R));
    shapeGuard(dimension(*b) == rows((*factor).Q));

    usize m = rows((*factor).Q);
    usize n = columns((*factor).R);
    T zero = 0;
    usize i = 1;
    while (i <= n) {
        if ((*factor).R[i,i] == zero) {
            throw RankDeficientMatrixException();
        }
        i = i + 1;
    }

    Vector<T,Column> w = vectorFilled<T,Column>(n, zero);
    i = 1;
    while (i <= n) {
        T value = zero;
        usize k = 1;
        while (k <= m) {
            T product = (*factor).Q[k,i] * (*b)[k];
            value = value + product;
            k = k + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        T value = w[i];
        usize j = i + 1;
        while (j <= n) {
            T product = (*factor).R[i,j] * w[j];
            value = value - product;
            j = j + 1;
        }
        w[i] = value / (*factor).R[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

// Solve one or more square or tall full-column-rank right-hand sides.
public Matrix<T> solve<T: IEEEFloat>(
    ref QR<T> factor,
    ref Matrix<T> B) {
    shapeGuard(rows((*factor).Q) == columns((*factor).Q));
    shapeGuard(rows((*factor).R) == rows((*factor).Q));
    shapeGuard(rows((*factor).R) >= columns((*factor).R));
    shapeGuard(rows(*B) == rows((*factor).Q));

    usize m = rows((*factor).Q);
    usize n = columns((*factor).R);
    usize q = columns(*B);
    T zero = 0;
    usize i = 1;
    while (i <= n) {
        if ((*factor).R[i,i] == zero) {
            throw RankDeficientMatrixException();
        }
        i = i + 1;
    }

    Matrix<T> W = matrixFilled<T>(n, q, zero);
    i = 1;
    while (i <= n) {
        usize c = 1;
        while (c <= q) {
            T value = zero;
            usize k = 1;
            while (k <= m) {
                T product = (*factor).Q[k,i] * (*B)[k,c];
                value = value + product;
                k = k + 1;
            }
            W[i,c] = value;
            c = c + 1;
        }
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        usize c = 1;
        while (c <= q) {
            T value = W[i,c];
            usize j = i + 1;
            while (j <= n) {
                T product = (*factor).R[i,j] * W[j,c];
                value = value - product;
                j = j + 1;
            }
            W[i,c] = value / (*factor).R[i,i];
            c = c + 1;
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return W;
}

// Householder QR for the IEEE floating-point element types.
public QR<T> qr<T: IEEEFloat>(ref Matrix<T> A) {
    Matrix<T> workspace = copyMatrixForFactorization<T>(A);
    return qrInPlace(workspace);
}

// Householder QR for the IEEE floating-point element types.
public QR<T> qrInPlace<T: IEEEFloat>(Matrix<T> A) {
    T zero = 0;
    T one = 1;
    T two = one + one;
    usize m = rows(A);
    usize n = columns(A);
    usize p = m;
    if (n < p) { p = n; }

    Matrix<T> Q = identity<T>(m);
    usize i = 1;
    usize j = 1;

    Matrix<T> R = A;
    usize k = 1;
    while (k <= p) {
        StableScaledSquares<T> state =
            stableScaledSquaresRange<T>(column(R,k), k, m);

        if (state.scale != zero) {
            T norm = finishStableNormNonzero<T>(state);
            T alpha = norm;
            if (R[k,k] >= zero) { alpha = -norm; }
            T first = R[k,k] - alpha;
            T reflectorSquared = one;
            i = k + 1;
            while (i <= m) {
                R[i,k] = R[i,k] / first;
                reflectorSquared = reflectorSquared + R[i,k] * R[i,k];
                i = i + 1;
            }

            // Q <- Q H.  The reflector tail still lives below R[k,k].
            i = 1;
            while (i <= m) {
                T dot = Q[i,k];
                usize r = k + 1;
                while (r <= m) {
                    dot = dot + Q[i,r] * R[r,k];
                    r = r + 1;
                }
                T scale = (two * dot) / reflectorSquared;
                Q[i,k] = Q[i,k] - scale;
                r = k + 1;
                while (r <= m) {
                    Q[i,r] = Q[i,r] - scale * R[r,k];
                    r = r + 1;
                }
                i = i + 1;
            }

            // Update later columns before replacing the reflector storage.
            j = k + 1;
            while (j <= n) {
                T dot = R[k,j];
                i = k + 1;
                while (i <= m) {
                    dot = dot + R[i,k] * R[i,j];
                    i = i + 1;
                }
                T scale = (two * dot) / reflectorSquared;
                R[k,j] = R[k,j] - scale;
                i = k + 1;
                while (i <= m) {
                    R[i,j] = R[i,j] - scale * R[i,k];
                    i = i + 1;
                }
                j = j + 1;
            }
            R[k,k] = alpha;
            i = k + 1;
            while (i <= m) {
                R[i,k] = zero;
                i = i + 1;
            }
        }
        k = k + 1;
    }
    return QR<T>(Q, R);
}

// Deprecated compatibility entry point.  qr is the primary generic API.
public QR<float32> qrFloat32(Matrix<float32> A) {
    return qrInPlace(A);
}
