package linearAlgebra;

// Runtime-shape constructors are ordinary overloads.  The expected result type
// selects both the element type and, for vectors, the orientation.
Matrix<float64> zeros(usize size) {
    return matrixFilled<float64>(size, size, 0.0);
}

Matrix<float32> zeros(usize size) {
    return matrixFilled<float32>(size, size, float32(0.0));
}

Matrix<float64> zeros(usize rowCount, usize columnCount) {
    return matrixFilled<float64>(rowCount, columnCount, 0.0);
}

Matrix<float32> zeros(usize rowCount, usize columnCount) {
    return matrixFilled<float32>(rowCount, columnCount, float32(0.0));
}

Vector<float64,Row> zeros(usize length) {
    return vectorFilled<float64,Row>(length, 0.0);
}

Vector<float64,Column> zeros(usize length) {
    return vectorFilled<float64,Column>(length, 0.0);
}

Vector<float32,Row> zeros(usize length) {
    return vectorFilled<float32,Row>(length, float32(0.0));
}

Vector<float32,Column> zeros(usize length) {
    return vectorFilled<float32,Column>(length, float32(0.0));
}

Matrix<float64> ones(usize size) {
    return matrixFilled<float64>(size, size, 1.0);
}

Matrix<float32> ones(usize size) {
    return matrixFilled<float32>(size, size, float32(1.0));
}

Matrix<float64> ones(usize rowCount, usize columnCount) {
    return matrixFilled<float64>(rowCount, columnCount, 1.0);
}

Matrix<float32> ones(usize rowCount, usize columnCount) {
    return matrixFilled<float32>(rowCount, columnCount, float32(1.0));
}

Vector<float64,Row> ones(usize length) {
    return vectorFilled<float64,Row>(length, 1.0);
}

Vector<float64,Column> ones(usize length) {
    return vectorFilled<float64,Column>(length, 1.0);
}

Vector<float32,Row> ones(usize length) {
    return vectorFilled<float32,Row>(length, float32(1.0));
}

Vector<float32,Column> ones(usize length) {
    return vectorFilled<float32,Column>(length, float32(1.0));
}

Matrix<float64> identity(usize size) {
    Matrix<float64> result = zeros(size, size);
    usize index = 1;
    while (index <= size) {
        result[index,index] = 1.0;
        index = index + 1;
    }
    return result;
}

Matrix<float32> identity(usize size) {
    Matrix<float32> result = zeros(size, size);
    usize index = 1;
    while (index <= size) {
        result[index,index] = float32(1.0);
        index = index + 1;
    }
    return result;
}

// An economic LU factorization with a 1-based row permutation.  The
// permutation represents P directly: (P A)[i,j] = A[permutation[i],j].
struct LU<T: Storable> {
    Vector<usize,Column> permutation;
    int permutationSign;
    Matrix<T> L;
    Matrix<T> U;
}

public class SingularMatrixException : Exception {
    public init() {}
}

LU<float64> lu(Matrix<float64> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize r = m;
    if (n < r) { r = n; }

    Vector<usize,Column> permutation = vectorFilled<usize,Column>(m, 0);
    usize i = 1;
    while (i <= m) {
        permutation[i] = i;
        i = i + 1;
    }
    int permutationSign = 1;

    usize k = 1;
    while (k <= r) {
        usize p = k;
        float64 best = abs(A[k,k]);
        i = k + 1;
        while (i <= m) {
            float64 magnitude = abs(A[i,k]);
            if (magnitude > best) {
                p = i;
                best = magnitude;
            }
            i = i + 1;
        }

        if (p != k) {
            usize j = 1;
            while (j <= n) {
                float64 temporary = A[k,j];
                A[k,j] = A[p,j];
                A[p,j] = temporary;
                j = j + 1;
            }
            usize permutationTemporary = permutation[k];
            permutation[k] = permutation[p];
            permutation[p] = permutationTemporary;
            permutationSign = -permutationSign;
        }

        if (A[k,k] != 0.0) {
            i = k + 1;
            while (i <= m) {
                A[i,k] = A[i,k] / A[k,k];
                usize j = k + 1;
                while (j <= n) {
                    A[i,j] = A[i,j] - A[i,k] * A[k,j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }

    if (m <= n) {
        Matrix<float64> L = matrixFilled<float64>(m, m, 0.0);
        i = 1;
        while (i <= m) {
            usize j = 1;
            while (j < i) {
                L[i,j] = A[i,j];
                A[i,j] = 0.0;
                j = j + 1;
            }
            L[i,i] = 1.0;
            i = i + 1;
        }
        return LU<float64>(permutation, permutationSign, L, A);
    }

    Matrix<float64> U = matrixFilled<float64>(n, n, 0.0);
    i = 1;
    while (i <= n) {
        usize j = i;
        while (j <= n) {
            U[i,j] = A[i,j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= m) {
        usize j = i + 1;
        while (j <= n) {
            A[i,j] = 0.0;
            j = j + 1;
        }
        if (i <= n) { A[i,i] = 1.0; }
        i = i + 1;
    }
    return LU<float64>(permutation, permutationSign, A, U);
}

LU<float32> lu(Matrix<float32> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize r = m;
    if (n < r) { r = n; }

    Vector<usize,Column> permutation = vectorFilled<usize,Column>(m, 0);
    usize i = 1;
    while (i <= m) {
        permutation[i] = i;
        i = i + 1;
    }
    int permutationSign = 1;

    usize k = 1;
    while (k <= r) {
        usize p = k;
        float32 best = abs(A[k,k]);
        i = k + 1;
        while (i <= m) {
            float32 magnitude = abs(A[i,k]);
            if (magnitude > best) {
                p = i;
                best = magnitude;
            }
            i = i + 1;
        }

        if (p != k) {
            usize j = 1;
            while (j <= n) {
                float32 temporary = A[k,j];
                A[k,j] = A[p,j];
                A[p,j] = temporary;
                j = j + 1;
            }
            usize permutationTemporary = permutation[k];
            permutation[k] = permutation[p];
            permutation[p] = permutationTemporary;
            permutationSign = -permutationSign;
        }

        if (A[k,k] != float32(0.0)) {
            i = k + 1;
            while (i <= m) {
                A[i,k] = A[i,k] / A[k,k];
                usize j = k + 1;
                while (j <= n) {
                    A[i,j] = A[i,j] - A[i,k] * A[k,j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }

    if (m <= n) {
        Matrix<float32> L = matrixFilled<float32>(m, m, float32(0.0));
        i = 1;
        while (i <= m) {
            usize j = 1;
            while (j < i) {
                L[i,j] = A[i,j];
                A[i,j] = float32(0.0);
                j = j + 1;
            }
            L[i,i] = float32(1.0);
            i = i + 1;
        }
        return LU<float32>(permutation, permutationSign, L, A);
    }

    Matrix<float32> U = matrixFilled<float32>(n, n, float32(0.0));
    i = 1;
    while (i <= n) {
        usize j = i;
        while (j <= n) {
            U[i,j] = A[i,j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= m) {
        usize j = i + 1;
        while (j <= n) {
            A[i,j] = float32(0.0);
            j = j + 1;
        }
        if (i <= n) { A[i,i] = float32(1.0); }
        i = i + 1;
    }
    return LU<float32>(permutation, permutationSign, A, U);
}

Vector<float64,Column> solve(
    ref LU<float64> factor,
    ref Vector<float64,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    usize n = rows((*factor).U);
    Vector<float64,Column> w = vectorFilled<float64,Column>(n, 0.0);
    usize i = 1;
    while (i <= n) {
        w[i] = (*b)[(*factor).permutation[i]];
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        float64 value = w[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        if ((*factor).U[i,i] == 0.0) {
            throw SingularMatrixException();
        }
        float64 value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).U[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).U[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

Vector<float32,Column> solve(
    ref LU<float32> factor,
    ref Vector<float32,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    usize n = rows((*factor).U);
    Vector<float32,Column> w = vectorFilled<float32,Column>(n, float32(0.0));
    usize i = 1;
    while (i <= n) {
        w[i] = (*b)[(*factor).permutation[i]];
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        float32 value = w[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        if ((*factor).U[i,i] == float32(0.0)) {
            throw SingularMatrixException();
        }
        float32 value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).U[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).U[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

Vector<float64,Column> solve(
    Matrix<float64> A,
    ref Vector<float64,Column> b) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(dimension(*b) == rows(A));
    LU<float64> factor = lu(A);
    return solve(factor, b);
}

Vector<float32,Column> solve(
    Matrix<float32> A,
    ref Vector<float32,Column> b) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(dimension(*b) == rows(A));
    LU<float32> factor = lu(A);
    return solve(factor, b);
}

// A materialized QR factorization.  Q is m by m and R is m by n.
struct QR<T: Storable> {
    Matrix<T> Q;
    Matrix<T> R;
}

// Householder QR for the V1 default real type (float64/double).
QR<float64> qr(Matrix<float64> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize p = m;
    if (n < p) { p = n; }

    Matrix<float64> Q = identity(m);
    usize i = 1;
    usize j = 1;

    Matrix<float64> R = A;
    usize k = 1;
    while (k <= p) {
        // Scaled sum of squares avoids avoidable overflow/underflow in ||x||.
        float64 normScale = 0.0;
        float64 scaledSquares = 1.0;
        i = k;
        while (i <= m) {
            float64 magnitude = abs(R[i,k]);
            if (magnitude != 0.0) {
                if (normScale < magnitude) {
                    float64 ratio = normScale / magnitude;
                    scaledSquares = 1.0 + scaledSquares * ratio * ratio;
                    normScale = magnitude;
                }
                else {
                    float64 ratio = magnitude / normScale;
                    scaledSquares = scaledSquares + ratio * ratio;
                }
            }
            i = i + 1;
        }

        if (normScale != 0.0) {
            float64 norm = normScale * sqrt(scaledSquares);
            float64 alpha = norm;
            if (R[k,k] >= 0.0) { alpha = -norm; }
            float64 first = R[k,k] - alpha;
            float64 reflectorSquared = 1.0;
            i = k + 1;
            while (i <= m) {
                R[i,k] = R[i,k] / first;
                reflectorSquared = reflectorSquared + R[i,k] * R[i,k];
                i = i + 1;
            }

            // Q <- Q H.  The reflector tail still lives below R[k,k].
            i = 1;
            while (i <= m) {
                float64 dot = Q[i,k];
                usize r = k + 1;
                while (r <= m) {
                    dot = dot + Q[i,r] * R[r,k];
                    r = r + 1;
                }
                float64 scale = (2.0 * dot) / reflectorSquared;
                Q[i,k] = Q[i,k] - scale;
                r = k + 1;
                while (r <= m) {
                    Q[i,r] = Q[i,r] - scale * R[r,k];
                    r = r + 1;
                }
                i = i + 1;
            }

            // Update later columns before replacing the reflector storage.
            j = k + 1;
            while (j <= n) {
                float64 dot = R[k,j];
                i = k + 1;
                while (i <= m) {
                    dot = dot + R[i,k] * R[i,j];
                    i = i + 1;
                }
                float64 scale = (2.0 * dot) / reflectorSquared;
                R[k,j] = R[k,j] - scale;
                i = k + 1;
                while (i <= m) {
                    R[i,j] = R[i,j] - scale * R[i,k];
                    i = i + 1;
                }
                j = j + 1;
            }
            R[k,k] = alpha;
            i = k + 1;
            while (i <= m) {
                R[i,k] = 0.0;
                i = i + 1;
            }
        }
        k = k + 1;
    }
    return QR<float64>(Q, R);
}

// float32 is explicit because V1 generics cannot constrain T to floating-point
// operations (sqrt and division).  qr remains the primary float64 entry point.
QR<float32> qrFloat32(Matrix<float32> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize p = m;
    if (n < p) { p = n; }

    Matrix<float32> Q = identity(m);
    usize i = 1;
    usize j = 1;

    Matrix<float32> R = A;
    usize k = 1;
    while (k <= p) {
        float32 normScale = float32(0.0);
        float32 scaledSquares = float32(1.0);
        i = k;
        while (i <= m) {
            float32 magnitude = abs(R[i,k]);
            if (magnitude != float32(0.0)) {
                if (normScale < magnitude) {
                    float32 ratio = normScale / magnitude;
                    scaledSquares = float32(1.0) + scaledSquares * ratio * ratio;
                    normScale = magnitude;
                }
                else {
                    float32 ratio = magnitude / normScale;
                    scaledSquares = scaledSquares + ratio * ratio;
                }
            }
            i = i + 1;
        }

        if (normScale != float32(0.0)) {
            float32 norm = normScale * sqrt(scaledSquares);
            float32 alpha = norm;
            if (R[k,k] >= float32(0.0)) { alpha = -norm; }
            float32 first = R[k,k] - alpha;
            float32 reflectorSquared = float32(1.0);
            i = k + 1;
            while (i <= m) {
                R[i,k] = R[i,k] / first;
                reflectorSquared = reflectorSquared + R[i,k] * R[i,k];
                i = i + 1;
            }

            i = 1;
            while (i <= m) {
                float32 dot = Q[i,k];
                usize r = k + 1;
                while (r <= m) {
                    dot = dot + Q[i,r] * R[r,k];
                    r = r + 1;
                }
                float32 scale = (float32(2.0) * dot) / reflectorSquared;
                Q[i,k] = Q[i,k] - scale;
                r = k + 1;
                while (r <= m) {
                    Q[i,r] = Q[i,r] - scale * R[r,k];
                    r = r + 1;
                }
                i = i + 1;
            }

            j = k + 1;
            while (j <= n) {
                float32 dot = R[k,j];
                i = k + 1;
                while (i <= m) {
                    dot = dot + R[i,k] * R[i,j];
                    i = i + 1;
                }
                float32 scale = (float32(2.0) * dot) / reflectorSquared;
                R[k,j] = R[k,j] - scale;
                i = k + 1;
                while (i <= m) {
                    R[i,j] = R[i,j] - scale * R[i,k];
                    i = i + 1;
                }
                j = j + 1;
            }
            R[k,k] = alpha;
            i = k + 1;
            while (i <= m) {
                R[i,k] = float32(0.0);
                i = i + 1;
            }
        }
        k = k + 1;
    }
    return QR<float32>(Q, R);
}
