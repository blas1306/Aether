package linearAlgebra;

// Runtime-shape constructors are ordinary generic overloads.  The expected
// result type selects the element type and, for vectors, the orientation.
Matrix<T> zeros<T: Storable + Copy + Zero>(usize size) {
    return matrixFilled<T>(size, size, 0);
}

Matrix<T> zeros<T: Storable + Copy + Zero>(usize rowCount, usize columnCount) {
    return matrixFilled<T>(rowCount, columnCount, 0);
}

Vector<T,Row> zeros<T: Storable + Copy + Zero>(usize length) {
    return vectorFilled<T,Row>(length, 0);
}

Vector<T,Column> zeros<T: Storable + Copy + Zero>(usize length) {
    return vectorFilled<T,Column>(length, 0);
}

Matrix<T> ones<T: Storable + Copy + One>(usize size) {
    return matrixFilled<T>(size, size, 1);
}

Matrix<T> ones<T: Storable + Copy + One>(usize rowCount, usize columnCount) {
    return matrixFilled<T>(rowCount, columnCount, 1);
}

Vector<T,Row> ones<T: Storable + Copy + One>(usize length) {
    return vectorFilled<T,Row>(length, 1);
}

Vector<T,Column> ones<T: Storable + Copy + One>(usize length) {
    return vectorFilled<T,Column>(length, 1);
}

Matrix<T> identity<T: Storable + Copy + Zero + One>(usize size) {
    Matrix<T> result = zeros<T>(size, size);
    usize index = 1;
    while (index <= size) {
        result[index,index] = 1;
        index = index + 1;
    }
    return result;
}

// An economic LU factorization with a 1-based row permutation.  The
// permutation represents P directly: (P A)[i,j] = A[permutation[i],j].
struct LU<T: Storable> {
    Vector<usize,Column> permutation;
    int permutationSign;
    Matrix<T> L;
    Matrix<T> U;
}

public class SingularMatrixException : Exception {
    public init() {}
}

LU<T> lu<T: IEEEFloat>(Matrix<T> A) {
    T zero = 0;
    T one = 1;
    usize m = rows(A);
    usize n = columns(A);
    usize r = m;
    if (n < r) { r = n; }

    Vector<usize,Column> permutation = vectorFilled<usize,Column>(m, 0);
    usize i = 1;
    while (i <= m) {
        permutation[i] = i;
        i = i + 1;
    }
    int permutationSign = 1;

    usize k = 1;
    while (k <= r) {
        usize p = k;
        T best = abs(A[k,k]);
        i = k + 1;
        while (i <= m) {
            T magnitude = abs(A[i,k]);
            if (magnitude > best) {
                p = i;
                best = magnitude;
            }
            i = i + 1;
        }

        if (p != k) {
            usize j = 1;
            while (j <= n) {
                T temporary = A[k,j];
                A[k,j] = A[p,j];
                A[p,j] = temporary;
                j = j + 1;
            }
            usize permutationTemporary = permutation[k];
            permutation[k] = permutation[p];
            permutation[p] = permutationTemporary;
            permutationSign = -permutationSign;
        }

        if (A[k,k] != zero) {
            i = k + 1;
            while (i <= m) {
                A[i,k] = A[i,k] / A[k,k];
                usize j = k + 1;
                while (j <= n) {
                    A[i,j] = A[i,j] - A[i,k] * A[k,j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }

    if (m <= n) {
        Matrix<T> L = matrixFilled<T>(m, m, zero);
        i = 1;
        while (i <= m) {
            usize j = 1;
            while (j < i) {
                L[i,j] = A[i,j];
                A[i,j] = zero;
                j = j + 1;
            }
            L[i,i] = one;
            i = i + 1;
        }
        return LU<T>(permutation, permutationSign, L, A);
    }

    Matrix<T> U = matrixFilled<T>(n, n, zero);
    i = 1;
    while (i <= n) {
        usize j = i;
        while (j <= n) {
            U[i,j] = A[i,j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 1;
    while (i <= m) {
        usize j = i + 1;
        while (j <= n) {
            A[i,j] = zero;
            j = j + 1;
        }
        if (i <= n) { A[i,i] = one; }
        i = i + 1;
    }
    return LU<T>(permutation, permutationSign, A, U);
}

float64 det(ref LU<float64> factor) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));

    float64 result = float64((*factor).permutationSign);
    usize i = 1;
    while (i <= rows((*factor).U)) {
        result = result * (*factor).U[i,i];
        i = i + 1;
    }
    return result;
}

float32 det(ref LU<float32> factor) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));

    float32 result = float32((*factor).permutationSign);
    usize i = 1;
    while (i <= rows((*factor).U)) {
        result = result * (*factor).U[i,i];
        i = i + 1;
    }
    return result;
}

float64 det(Matrix<float64> A) {
    shapeGuard(rows(A) == columns(A));
    LU<float64> factor = lu(A);
    return det(factor);
}

float32 det(Matrix<float32> A) {
    shapeGuard(rows(A) == columns(A));
    LU<float32> factor = lu(A);
    return det(factor);
}

Vector<float64,Column> solve(
    ref LU<float64> factor,
    ref Vector<float64,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    usize n = rows((*factor).U);
    Vector<float64,Column> w = vectorFilled<float64,Column>(n, 0.0);
    usize i = 1;
    while (i <= n) {
        w[i] = (*b)[(*factor).permutation[i]];
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        float64 value = w[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        if ((*factor).U[i,i] == 0.0) {
            throw SingularMatrixException();
        }
        float64 value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).U[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).U[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

Vector<float32,Column> solve(
    ref LU<float32> factor,
    ref Vector<float32,Column> b) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).L));
    shapeGuard(dimension(*b) == rows((*factor).L));

    usize n = rows((*factor).U);
    Vector<float32,Column> w = vectorFilled<float32,Column>(n, float32(0.0));
    usize i = 1;
    while (i <= n) {
        w[i] = (*b)[(*factor).permutation[i]];
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        float32 value = w[i];
        usize j = 1;
        while (j < i) {
            value = value - (*factor).L[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value;
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        if ((*factor).U[i,i] == float32(0.0)) {
            throw SingularMatrixException();
        }
        float32 value = w[i];
        usize j = i + 1;
        while (j <= n) {
            value = value - (*factor).U[i,j] * w[j];
            j = j + 1;
        }
        w[i] = value / (*factor).U[i,i];
        if (i == 1) { break; }
        i = i - 1;
    }
    return w;
}

Vector<float64,Column> solve(
    Matrix<float64> A,
    ref Vector<float64,Column> b) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(dimension(*b) == rows(A));
    LU<float64> factor = lu(A);
    return solve(factor, b);
}

Vector<float32,Column> solve(
    Matrix<float32> A,
    ref Vector<float32,Column> b) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(dimension(*b) == rows(A));
    LU<float32> factor = lu(A);
    return solve(factor, b);
}

Matrix<float64> solve(
    ref LU<float64> factor,
    ref Matrix<float64> B) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));
    shapeGuard(rows(*B) == rows((*factor).U));

    usize n = rows((*factor).U);
    usize q = columns(*B);
    Matrix<float64> W = matrixFilled<float64>(n, q, 0.0);
    usize i = 1;
    while (i <= n) {
        usize c = 1;
        while (c <= q) {
            W[i,c] = (*B)[(*factor).permutation[i],c];
            c = c + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        usize j = 1;
        while (j < i) {
            float64 coefficient = (*factor).L[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        float64 diagonal = (*factor).U[i,i];
        if (diagonal == 0.0) {
            throw SingularMatrixException();
        }
        usize j = i + 1;
        while (j <= n) {
            float64 coefficient = (*factor).U[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        usize c = 1;
        while (c <= q) {
            W[i,c] = W[i,c] / diagonal;
            c = c + 1;
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return W;
}

Matrix<float32> solve(
    ref LU<float32> factor,
    ref Matrix<float32> B) {
    shapeGuard(rows((*factor).L) == columns((*factor).L));
    shapeGuard(rows((*factor).U) == columns((*factor).U));
    shapeGuard(rows((*factor).L) == rows((*factor).U));
    shapeGuard(dimension((*factor).permutation) == rows((*factor).U));
    shapeGuard(rows(*B) == rows((*factor).U));

    usize n = rows((*factor).U);
    usize q = columns(*B);
    Matrix<float32> W = matrixFilled<float32>(n, q, float32(0.0));
    usize i = 1;
    while (i <= n) {
        usize c = 1;
        while (c <= q) {
            W[i,c] = (*B)[(*factor).permutation[i],c];
            c = c + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        usize j = 1;
        while (j < i) {
            float32 coefficient = (*factor).L[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = n;
    while (i > 0) {
        float32 diagonal = (*factor).U[i,i];
        if (diagonal == float32(0.0)) {
            throw SingularMatrixException();
        }
        usize j = i + 1;
        while (j <= n) {
            float32 coefficient = (*factor).U[i,j];
            usize c = 1;
            while (c <= q) {
                W[i,c] = W[i,c] - coefficient * W[j,c];
                c = c + 1;
            }
            j = j + 1;
        }
        usize c = 1;
        while (c <= q) {
            W[i,c] = W[i,c] / diagonal;
            c = c + 1;
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return W;
}

Matrix<float64> solve(
    Matrix<float64> A,
    ref Matrix<float64> B) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(rows(*B) == rows(A));
    LU<float64> factor = lu(A);
    return solve(factor, B);
}

Matrix<float32> solve(
    Matrix<float32> A,
    ref Matrix<float32> B) {
    shapeGuard(rows(A) == columns(A));
    shapeGuard(rows(*B) == rows(A));
    LU<float32> factor = lu(A);
    return solve(factor, B);
}

// A materialized QR factorization.  Q is m by m and R is m by n.
struct QR<T: Storable> {
    Matrix<T> Q;
    Matrix<T> R;
}

// Householder QR for the V1 default real type (float64/double).
QR<float64> qr(Matrix<float64> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize p = m;
    if (n < p) { p = n; }

    Matrix<float64> Q = identity(m);
    usize i = 1;
    usize j = 1;

    Matrix<float64> R = A;
    usize k = 1;
    while (k <= p) {
        // Scaled sum of squares avoids avoidable overflow/underflow in ||x||.
        float64 normScale = 0.0;
        float64 scaledSquares = 1.0;
        i = k;
        while (i <= m) {
            float64 magnitude = abs(R[i,k]);
            if (magnitude != 0.0) {
                if (normScale < magnitude) {
                    float64 ratio = normScale / magnitude;
                    scaledSquares = 1.0 + scaledSquares * ratio * ratio;
                    normScale = magnitude;
                }
                else {
                    float64 ratio = magnitude / normScale;
                    scaledSquares = scaledSquares + ratio * ratio;
                }
            }
            i = i + 1;
        }

        if (normScale != 0.0) {
            float64 norm = normScale * sqrt(scaledSquares);
            float64 alpha = norm;
            if (R[k,k] >= 0.0) { alpha = -norm; }
            float64 first = R[k,k] - alpha;
            float64 reflectorSquared = 1.0;
            i = k + 1;
            while (i <= m) {
                R[i,k] = R[i,k] / first;
                reflectorSquared = reflectorSquared + R[i,k] * R[i,k];
                i = i + 1;
            }

            // Q <- Q H.  The reflector tail still lives below R[k,k].
            i = 1;
            while (i <= m) {
                float64 dot = Q[i,k];
                usize r = k + 1;
                while (r <= m) {
                    dot = dot + Q[i,r] * R[r,k];
                    r = r + 1;
                }
                float64 scale = (2.0 * dot) / reflectorSquared;
                Q[i,k] = Q[i,k] - scale;
                r = k + 1;
                while (r <= m) {
                    Q[i,r] = Q[i,r] - scale * R[r,k];
                    r = r + 1;
                }
                i = i + 1;
            }

            // Update later columns before replacing the reflector storage.
            j = k + 1;
            while (j <= n) {
                float64 dot = R[k,j];
                i = k + 1;
                while (i <= m) {
                    dot = dot + R[i,k] * R[i,j];
                    i = i + 1;
                }
                float64 scale = (2.0 * dot) / reflectorSquared;
                R[k,j] = R[k,j] - scale;
                i = k + 1;
                while (i <= m) {
                    R[i,j] = R[i,j] - scale * R[i,k];
                    i = i + 1;
                }
                j = j + 1;
            }
            R[k,k] = alpha;
            i = k + 1;
            while (i <= m) {
                R[i,k] = 0.0;
                i = i + 1;
            }
        }
        k = k + 1;
    }
    return QR<float64>(Q, R);
}

// float32 is explicit because V1 generics cannot constrain T to floating-point
// operations (sqrt and division).  qr remains the primary float64 entry point.
QR<float32> qrFloat32(Matrix<float32> A) {
    usize m = rows(A);
    usize n = columns(A);
    usize p = m;
    if (n < p) { p = n; }

    Matrix<float32> Q = identity(m);
    usize i = 1;
    usize j = 1;

    Matrix<float32> R = A;
    usize k = 1;
    while (k <= p) {
        float32 normScale = float32(0.0);
        float32 scaledSquares = float32(1.0);
        i = k;
        while (i <= m) {
            float32 magnitude = abs(R[i,k]);
            if (magnitude != float32(0.0)) {
                if (normScale < magnitude) {
                    float32 ratio = normScale / magnitude;
                    scaledSquares = float32(1.0) + scaledSquares * ratio * ratio;
                    normScale = magnitude;
                }
                else {
                    float32 ratio = magnitude / normScale;
                    scaledSquares = scaledSquares + ratio * ratio;
                }
            }
            i = i + 1;
        }

        if (normScale != float32(0.0)) {
            float32 norm = normScale * sqrt(scaledSquares);
            float32 alpha = norm;
            if (R[k,k] >= float32(0.0)) { alpha = -norm; }
            float32 first = R[k,k] - alpha;
            float32 reflectorSquared = float32(1.0);
            i = k + 1;
            while (i <= m) {
                R[i,k] = R[i,k] / first;
                reflectorSquared = reflectorSquared + R[i,k] * R[i,k];
                i = i + 1;
            }

            i = 1;
            while (i <= m) {
                float32 dot = Q[i,k];
                usize r = k + 1;
                while (r <= m) {
                    dot = dot + Q[i,r] * R[r,k];
                    r = r + 1;
                }
                float32 scale = (float32(2.0) * dot) / reflectorSquared;
                Q[i,k] = Q[i,k] - scale;
                r = k + 1;
                while (r <= m) {
                    Q[i,r] = Q[i,r] - scale * R[r,k];
                    r = r + 1;
                }
                i = i + 1;
            }

            j = k + 1;
            while (j <= n) {
                float32 dot = R[k,j];
                i = k + 1;
                while (i <= m) {
                    dot = dot + R[i,k] * R[i,j];
                    i = i + 1;
                }
                float32 scale = (float32(2.0) * dot) / reflectorSquared;
                R[k,j] = R[k,j] - scale;
                i = k + 1;
                while (i <= m) {
                    R[i,j] = R[i,j] - scale * R[i,k];
                    i = i + 1;
                }
                j = j + 1;
            }
            R[k,k] = alpha;
            i = k + 1;
            while (i <= m) {
                R[i,k] = float32(0.0);
                i = i + 1;
            }
        }
        k = k + 1;
    }
    return QR<float32>(Q, R);
}
