class IndirectError implements Error {
    string text;
    public string message() { return text; }
}

void fail() { throw IndirectError("indirect call"); }

void apply(Function<(), void> operation) { operation(); }

int main() {
    try {
        apply(fail);
    } catch (IndirectError caught) {
        println("handler:indirect");
        println(caught.message());
    }
    return 0;
}
