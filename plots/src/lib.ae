package plots;

import graphics;
import std.Format;
import std.Text;

public struct DataPoint {
    float64 x;
    float64 y;
}

public struct Limits {
    float64 minimum;
    float64 maximum;
}

enum LimitMode {
    Auto,
    Explicit(Limits),
}

public struct LineStyle {
    graphics.Color color;
    float64 width;
}

public struct ScatterStyle {
    graphics.Color color;
    float64 diameter;
}

public struct FigureOptions {
    graphics.Viewport viewport;
    LimitMode xLimits;
    LimitMode yLimits;
    string title;
    string xLabel;
    string yLabel;
    LineStyle line;
}

public open class PlotException : Exception {
    public init() {}
}

public class EmptySeriesException : PlotException {
    public init() : base() {}
}

public class NoFiniteDataException : PlotException {
    public init() : base() {}
}

public class InvalidFigureException : PlotException {
    public init() : base() {}
}

public class InvalidLimitsException : PlotException {
    public init() : base() {}
}

public class PlotRangeException : PlotException {
    public init() : base() {}
}

public class InvalidSampleCountException : PlotException {
    public init() : base() {}
}

public class InvalidSampleIntervalException : PlotException {
    public init() : base() {}
}

struct FigureConstruction {
    int marker;
}

enum SeriesKind {
    Line,
    Scatter,
}

struct SeriesRecord {
    SeriesKind kind;
    usize start;
    usize length;
    uint8 red;
    uint8 green;
    uint8 blue;
    uint8 alpha;
    float64 size;
}

bool finite(float64 value) {
    return value - value == 0.0;
}

bool finitePoint(DataPoint point) {
    return finite(point.x) && finite(point.y);
}

string copyText(ref string value) {
    usize count = byteLength(*value);
    Buffer<uint8> bytes = Buffer<uint8>(count, uint8(0));
    usize index = 0;
    while (index < count) {
        bytes[index] = std.Text.byteAt(*value, index);
        index = index + 1;
    }
    return std.Text.fromUtf8(&bytes, count);
}

graphics.Color black() {
    return graphics.Color(uint8(0), uint8(0), uint8(0), uint8(255));
}

graphics.Stroke axisStroke() {
    return graphics.Stroke(
        black(), 1.0, graphics.LineCap.Butt, graphics.LineJoin.Miter, 4.0);
}

graphics.TextStyle textStyle(
    float64 size, graphics.TextAlign align, graphics.TextBaseline baseline) {
    return graphics.TextStyle(
        size, black(),
        graphics.FontRequest(
            graphics.FontFamily.SansSerif,
            graphics.FontWeight.Normal,
            graphics.FontSlant.Normal),
        align, baseline);
}

Limits expandLimits(Limits raw) {
    float64 minimum = raw.minimum;
    float64 maximum = raw.maximum;
    if (minimum == maximum) {
        float64 delta = abs(minimum) * 0.05;
        if (delta < 1.0) { delta = 1.0; }
        float64 lower = minimum - delta;
        float64 upper = maximum + delta;
        if (!finite(lower)) { lower = minimum; }
        if (!finite(upper)) { upper = maximum; }
        minimum = lower;
        maximum = upper;
    }
    float64 span = maximum - minimum;
    if (!finite(minimum) || !finite(maximum) || !finite(span) ||
        !(minimum < maximum) || !(span > 0.0)) {
        throw PlotRangeException();
    }
    return Limits(minimum, maximum);
}

Limits resolveAxis(
    ref Buffer<DataPoint> points,
    usize pointLength,
    LimitMode mode,
    bool useX) {
    match (mode) {
        LimitMode.Explicit(value) => { return expandLimits(value); }
        LimitMode.Auto => {
            usize index = 0;
            bool found = false;
            float64 minimum = 0.0;
            float64 maximum = 0.0;
            while (index < pointLength) {
                DataPoint point = (*points)[index];
                if (finitePoint(point)) {
                    float64 value = point.y;
                    if (useX) { value = point.x; }
                    if (!found) {
                        minimum = value;
                        maximum = value;
                        found = true;
                    } else {
                        if (value < minimum) { minimum = value; }
                        if (value > maximum) { maximum = value; }
                    }
                }
                index = index + 1;
            }
            if (!found) { throw NoFiniteDataException(); }
            return expandLimits(Limits(minimum, maximum));
        }
    }
}

void validateExplicit(LimitMode mode) {
    match (mode) {
        LimitMode.Auto => { }
        LimitMode.Explicit(value) => {
            if (!finite(value.minimum) || !finite(value.maximum) ||
                value.minimum > value.maximum) {
                throw InvalidLimitsException();
            }
        }
    }
}

graphics.Point transformPoint(
    DataPoint point,
    Limits xLimits,
    Limits yLimits,
    float64 plotLeft,
    float64 plotTop,
    float64 plotWidth,
    float64 plotHeight) {
    float64 sx = plotWidth / (xLimits.maximum - xLimits.minimum);
    float64 sy = plotHeight / (yLimits.maximum - yLimits.minimum);
    float64 x = plotLeft + (point.x - xLimits.minimum) * sx;
    float64 y = plotTop + plotHeight - (point.y - yLimits.minimum) * sy;
    if (!finite(x) || !finite(y)) { throw PlotRangeException(); }
    return graphics.Point(x, y);
}

float64 tickValue(Limits limits, int index) {
    float64 value = limits.minimum +
        (limits.maximum - limits.minimum) * float64(index) / 4.0;
    if (value == 0.0) { value = 0.0; }
    if (!finite(value)) { throw PlotRangeException(); }
    return value;
}

int decimalOrder(float64 positive) {
    int order = 0;
    float64 scaled = positive;
    if (scaled >= 10.0) {
        while (scaled >= 10.0 && order < 309) {
            scaled = scaled / 10.0;
            order = order + 1;
        }
    } else {
        while (scaled < 1.0 && order > -324) {
            scaled = scaled * 10.0;
            order = order - 1;
        }
    }
    return order;
}

string trimTickText(ref string value) {
    usize count = byteLength(*value);
    usize exponent = count;
    usize point = count;
    usize index = 0;
    while (index < count) {
        uint8 byte = std.Text.byteAt(*value, index);
        if (byte == uint8(46)) { point = index; }
        if (byte == uint8(101)) {
            exponent = index;
            index = count;
        } else {
            index = index + 1;
        }
    }

    usize mantissaEnd = exponent;
    if (point < exponent) {
        while (mantissaEnd > point + 1 &&
               std.Text.byteAt(*value, mantissaEnd - 1) == uint8(48)) {
            mantissaEnd = mantissaEnd - 1;
        }
        if (mantissaEnd == point + 1) { mantissaEnd = point; }
    }

    usize resultLength = mantissaEnd + count - exponent;
    Buffer<uint8> bytes = Buffer<uint8>(resultLength, uint8(0));
    index = 0;
    while (index < mantissaEnd) {
        bytes[index] = std.Text.byteAt(*value, index);
        index = index + 1;
    }
    usize source = exponent;
    while (source < count) {
        bytes[index] = std.Text.byteAt(*value, source);
        index = index + 1;
        source = source + 1;
    }
    return std.Text.fromUtf8(&bytes, resultLength);
}

struct TickFormat {
    bool canonical;
    bool fixed;
    int precision;
}

struct ParsedTick {
    bool valid;
    float64 value;
}

string formatTickValue(float64 value, TickFormat format) {
    if (format.canonical) { return str(value); }
    if (value == 0.0) { return "0"; }
    if (format.fixed) {
        string fixed = std.Format.fixed(value, usize(format.precision));
        return trimTickText(&fixed);
    }
    string scientific = std.Format.scientific(value, usize(format.precision));
    return trimTickText(&scientific);
}

ParsedTick parseFormattedTick(float64 original, TickFormat format) {
    string label = formatTickValue(original, format);
    match (std.Text.parseDouble(label)) {
        std.Text.DoubleParseResult.Value(parsed) => {
            bool valid = finite(parsed) && !(original != 0.0 && parsed == 0.0);
            return ParsedTick(valid, parsed);
        }
        std.Text.DoubleParseResult.Invalid => { return ParsedTick(false, 0.0); }
        std.Text.DoubleParseResult.Overflow => { return ParsedTick(false, 0.0); }
        std.Text.DoubleParseResult.Underflow => { return ParsedTick(false, 0.0); }
    }
}

bool tickFormatPreservesOrder(
    ref Buffer<float64> values,
    TickFormat format) {
    ParsedTick previous = parseFormattedTick((*values)[0], format);
    if (!previous.valid) { return false; }
    usize index = 1;
    while (index < 5) {
        ParsedTick current = parseFormattedTick((*values)[index], format);
        if (!current.valid) { return false; }
        float64 left = (*values)[index - 1];
        float64 right = (*values)[index];
        float64 previousParsed = previous.value;
        float64 currentParsed = current.value;
        if (left < right) {
            if (!(previousParsed < currentParsed)) { return false; }
        } else {
            if (left != right || previousParsed != currentParsed) { return false; }
        }
        previous = current;
        index = index + 1;
    }
    return true;
}

TickFormat selectTickFormat(Limits limits) {
    Buffer<float64> values = Buffer<float64>(5, 0.0);
    usize index = 0;
    while (index < 5) {
        values[index] = tickValue(limits, int(index));
        index = index + 1;
    }

    bool hasSpacing = false;
    float64 spacing = 0.0;
    index = 1;
    while (index < 5) {
        float64 difference = values[index] - values[index - 1];
        if (difference > 0.0 && (!hasSpacing || difference < spacing)) {
            spacing = difference;
            hasSpacing = true;
        }
        index = index + 1;
    }
    if (!hasSpacing) { return TickFormat(true, false, 0); }

    float64 largest = 0.0;
    float64 smallestNonzero = 0.0;
    bool hasNonzero = false;
    index = 0;
    while (index < 5) {
        float64 magnitude = abs(values[index]);
        if (magnitude > largest) { largest = magnitude; }
        if (magnitude > 0.0 && (!hasNonzero || magnitude < smallestNonzero)) {
            smallestNonzero = magnitude;
            hasNonzero = true;
        }
        index = index + 1;
    }
    if (!hasNonzero) { return TickFormat(true, false, 0); }

    int spacingOrder = decimalOrder(spacing);
    int largestOrder = decimalOrder(largest);
    int smallestOrder = decimalOrder(smallestNonzero);
    int fixedFractional = 1 - spacingOrder;
    if (fixedFractional < 0) { fixedFractional = 0; }
    int integerDigits = largestOrder + 1;
    if (integerDigits < 1) { integerDigits = 1; }
    int predictedFixed = integerDigits + fixedFractional + 2;
    bool useFixed = smallestOrder >= -6 && largestOrder < 21 &&
        fixedFractional <= 12 && predictedFixed <= 24;

    int significantDigits = largestOrder - spacingOrder + 2;
    if (significantDigits < 1) { significantDigits = 1; }
    if (significantDigits > 17) { significantDigits = 17; }
    int precision = significantDigits - 1;
    if (useFixed) { precision = fixedFractional; }

    int maximumPrecision = 16;
    if (useFixed) { maximumPrecision = 16 - largestOrder; }
    if (maximumPrecision < precision) { maximumPrecision = precision; }

    while (precision <= maximumPrecision) {
        TickFormat candidate = TickFormat(false, useFixed, precision);
        if (tickFormatPreservesOrder(&values, candidate)) { return candidate; }
        precision = precision + 1;
    }
    return TickFormat(true, false, 0);
}

public class Figure2D {
    Buffer<DataPoint> points;
    usize pointLength;
    usize pointCapacity;
    Buffer<SeriesRecord> series;
    usize seriesLength;
    usize seriesCapacity;
    float64 viewportWidth;
    float64 viewportHeight;
    LimitMode xLimits;
    LimitMode yLimits;
    string title;
    string xLabel;
    string yLabel;

    public init(
        FigureConstruction construction,
        Buffer<DataPoint> ownedPoints,
        usize ownedPointLength,
        usize ownedPointCapacity,
        Buffer<SeriesRecord> ownedSeries,
        usize ownedSeriesLength,
        usize ownedSeriesCapacity,
        graphics.Viewport ownedViewport,
        LimitMode ownedXLimits,
        LimitMode ownedYLimits,
        string ownedTitle,
        string ownedXLabel,
        string ownedYLabel) {
        points = ownedPoints;
        pointLength = ownedPointLength;
        pointCapacity = ownedPointCapacity;
        series = ownedSeries;
        seriesLength = ownedSeriesLength;
        seriesCapacity = ownedSeriesCapacity;
        viewportWidth = ownedViewport.width;
        viewportHeight = ownedViewport.height;
        xLimits = ownedXLimits;
        yLimits = ownedYLimits;
        title = ownedTitle;
        xLabel = ownedXLabel;
        yLabel = ownedYLabel;
    }

    Limits resolveOwnedAxis(LimitMode mode, bool useX) {
        match (mode) {
            LimitMode.Explicit(value) => { return expandLimits(value); }
            LimitMode.Auto => {
                usize seriesIndex = 0;
                bool found = false;
                float64 minimum = 0.0;
                float64 maximum = 0.0;
                while (seriesIndex < seriesLength) {
                    SeriesRecord record = series[seriesIndex];
                    usize end = record.start + record.length;
                    usize index = record.start;
                    while (index < end) {
                        DataPoint point = points[index];
                        if (finitePoint(point)) {
                            float64 value = point.y;
                            if (useX) { value = point.x; }
                            if (!found) {
                                minimum = value;
                                maximum = value;
                                found = true;
                            } else {
                                if (value < minimum) { minimum = value; }
                                if (value > maximum) { maximum = value; }
                            }
                        }
                        index = index + 1;
                    }
                    seriesIndex = seriesIndex + 1;
                }
                if (!found) { throw NoFiniteDataException(); }
                return expandLimits(Limits(minimum, maximum));
            }
        }
    }

    mut void appendSeries(
        ref Array<DataPoint> source,
        SeriesKind kind,
        graphics.Color color,
        float64 size) {
        usize count = length(*source);
        if (count == 0) { throw EmptySeriesException(); }
        if (!finite(size) || !(size > 0.0)) {
            throw InvalidFigureException();
        }

        usize index = 0;
        bool foundFinite = false;
        while (index < count) {
            if (finitePoint((*source)[index])) { foundFinite = true; }
            index = index + 1;
        }
        if (!foundFinite) { throw NoFiniteDataException(); }

        usize requiredPoints = pointLength + count;
        usize requiredSeries = seriesLength + 1;
        SeriesRecord record = SeriesRecord(
            kind, pointLength, count,
            color.red, color.green, color.blue, color.alpha, size);

        if (requiredPoints > pointCapacity || requiredSeries > seriesCapacity) {
            usize nextPointCapacity = pointCapacity;
            if (nextPointCapacity == 0) { nextPointCapacity = 4; }
            while (nextPointCapacity < requiredPoints) {
                nextPointCapacity = nextPointCapacity * 2;
            }
            usize nextSeriesCapacity = seriesCapacity;
            if (nextSeriesCapacity == 0) { nextSeriesCapacity = 4; }
            while (nextSeriesCapacity < requiredSeries) {
                nextSeriesCapacity = nextSeriesCapacity * 2;
            }

            Buffer<DataPoint> nextPoints = Buffer<DataPoint>(
                nextPointCapacity, DataPoint(0.0, 0.0));
            Buffer<SeriesRecord> nextSeries = Buffer<SeriesRecord>(
                nextSeriesCapacity,
                SeriesRecord(
                    SeriesKind.Line, 0, 0,
                    uint8(0), uint8(0), uint8(0), uint8(0), 1.0));
            index = 0;
            while (index < pointLength) {
                nextPoints[index] = points[index];
                index = index + 1;
            }
            index = 0;
            while (index < seriesLength) {
                nextSeries[index] = series[index];
                index = index + 1;
            }
            index = 0;
            while (index < count) {
                nextPoints[pointLength + index] = (*source)[index];
                index = index + 1;
            }
            nextSeries[seriesLength] = record;

            points = nextPoints;
            series = nextSeries;
            pointCapacity = nextPointCapacity;
            seriesCapacity = nextSeriesCapacity;
        } else {
            index = 0;
            while (index < count) {
                points[pointLength + index] = (*source)[index];
                index = index + 1;
            }
            series[seriesLength] = record;
        }
        pointLength = requiredPoints;
        seriesLength = requiredSeries;
    }

    public mut void addLine(ref Array<DataPoint> source, LineStyle style) {
        appendSeries(source, SeriesKind.Line, style.color, style.width);
    }

    public mut void addScatter(ref Array<DataPoint> source, ScatterStyle style) {
        appendSeries(source, SeriesKind.Scatter, style.color, style.diameter);
    }

    public graphics.Scene scene() {
        Limits resolvedX = resolveOwnedAxis(xLimits, true);
        Limits resolvedY = resolveOwnedAxis(yLimits, false);
        float64 plotLeft = 72.0;
        float64 plotTop = 48.0;
        float64 plotWidth = viewportWidth - 96.0;
        float64 plotHeight = viewportHeight - 112.0;
        graphics.Rect plotRect = graphics.Rect(
            plotLeft, plotTop, plotWidth, plotHeight);

        graphics.SceneBuilder builder = graphics.SceneBuilder(
            graphics.Viewport(viewportWidth, viewportHeight));
        builder.drawRect(
            graphics.Rect(0.0, 0.0, viewportWidth, viewportHeight),
            graphics.Paint.FillOnly(graphics.Fill(
                graphics.Color(uint8(255), uint8(255), uint8(255), uint8(255)),
                graphics.FillRule.NonZero)));

        builder.pushState();
        builder.intersectClipRect(plotRect);
        usize seriesIndex = 0;
        while (seriesIndex < seriesLength) {
            SeriesRecord record = series[seriesIndex];
            match (record.kind) {
                SeriesKind.Line => {
                    graphics.Color seriesColor = graphics.Color(
                        record.red, record.green, record.blue, record.alpha);
                    graphics.Stroke seriesStroke = graphics.Stroke(
                        seriesColor, record.size,
                        graphics.LineCap.Butt, graphics.LineJoin.Miter, 4.0);
                    float64 pointDiameter = record.size;
                    if (pointDiameter < 2.0) { pointDiameter = 2.0; }
                    usize index = record.start;
                    usize end = record.start + record.length;
                    usize runLength = 0;
                    graphics.Point first = graphics.Point(0.0, 0.0);
                    while (index < end) {
                        DataPoint sample = points[index];
                        if (finitePoint(sample)) {
                            graphics.Point point = transformPoint(
                                sample, resolvedX, resolvedY,
                                plotLeft, plotTop, plotWidth, plotHeight);
                            if (runLength == 0) {
                                first = point;
                                runLength = 1;
                            } else {
                                if (runLength == 1) {
                                    builder.beginPolyline();
                                    builder.addPolylinePoint(first);
                                }
                                builder.addPolylinePoint(point);
                                runLength = runLength + 1;
                            }
                        } else {
                            if (runLength == 1) {
                                builder.drawPoint(first, pointDiameter, seriesColor);
                            } else {
                                if (runLength > 1) { builder.endPolyline(seriesStroke); }
                            }
                            runLength = 0;
                        }
                        index = index + 1;
                    }
                    if (runLength == 1) {
                        builder.drawPoint(first, pointDiameter, seriesColor);
                    } else {
                        if (runLength > 1) { builder.endPolyline(seriesStroke); }
                    }
                }
                SeriesKind.Scatter => {
                    graphics.Color seriesColor = graphics.Color(
                        record.red, record.green, record.blue, record.alpha);
                    usize index = record.start;
                    usize end = record.start + record.length;
                    while (index < end) {
                        DataPoint sample = points[index];
                        if (finitePoint(sample)) {
                            graphics.Point point = transformPoint(
                                sample, resolvedX, resolvedY,
                                plotLeft, plotTop, plotWidth, plotHeight);
                            builder.drawPoint(point, record.size, seriesColor);
                        }
                        index = index + 1;
                    }
                }
            }
            seriesIndex = seriesIndex + 1;
        }
        builder.popState();

        graphics.Stroke axes = axisStroke();
        builder.drawRect(plotRect, graphics.Paint.StrokeOnly(axes));

        int tick = 0;
        while (tick < 5) {
            float64 fraction = float64(tick) / 4.0;
            float64 x = plotLeft + plotWidth * fraction;
            float64 y = plotTop + plotHeight - plotHeight * fraction;
            builder.drawLine(
                graphics.Line(
                    graphics.Point(x, plotTop + plotHeight),
                    graphics.Point(x, plotTop + plotHeight + 6.0)),
                axes);
            builder.drawLine(
                graphics.Line(
                    graphics.Point(plotLeft, y),
                    graphics.Point(plotLeft - 6.0, y)),
                axes);
            tick = tick + 1;
        }

        graphics.TextStyle xTickStyle = textStyle(
            12.0, graphics.TextAlign.Center, graphics.TextBaseline.Top);
        graphics.TextStyle yTickStyle = textStyle(
            12.0, graphics.TextAlign.Right, graphics.TextBaseline.Middle);
        TickFormat xTickFormat = selectTickFormat(resolvedX);
        TickFormat yTickFormat = selectTickFormat(resolvedY);
        tick = 0;
        while (tick < 5) {
            float64 fraction = float64(tick) / 4.0;
            float64 x = plotLeft + plotWidth * fraction;
            float64 y = plotTop + plotHeight - plotHeight * fraction;
            string xText = formatTickValue(
                tickValue(resolvedX, tick), xTickFormat);
            string yText = formatTickValue(
                tickValue(resolvedY, tick), yTickFormat);
            builder.drawText(
                &xText, graphics.Point(x, plotTop + plotHeight + 10.0), &xTickStyle);
            builder.drawText(
                &yText, graphics.Point(plotLeft - 10.0, y), &yTickStyle);
            tick = tick + 1;
        }

        graphics.TextStyle axisLabelStyle = textStyle(
            14.0, graphics.TextAlign.Center, graphics.TextBaseline.Middle);
        if (xLabel != "") {
            string xLabelText = xLabel;
            builder.drawText(
                &xLabelText,
                graphics.Point(plotLeft + plotWidth / 2.0, viewportHeight - 18.0),
                &axisLabelStyle);
        }
        if (yLabel != "") {
            string yLabelText = yLabel;
            builder.pushState();
            builder.concatTransform(graphics.Transform2D(
                0.0, -1.0, 1.0, 0.0, 24.0, plotTop + plotHeight / 2.0));
            builder.drawText(&yLabelText, graphics.Point(0.0, 0.0), &axisLabelStyle);
            builder.popState();
        }
        if (title != "") {
            string titleText = title;
            graphics.TextStyle titleStyle = textStyle(
                16.0, graphics.TextAlign.Center, graphics.TextBaseline.Middle);
            builder.drawText(
                &titleText, graphics.Point(plotLeft + plotWidth / 2.0, 24.0), &titleStyle);
        }
        return builder.finish();
    }
}

public FigureOptions defaultOptions() {
    return FigureOptions(
        graphics.Viewport(640.0, 480.0),
        LimitMode.Auto,
        LimitMode.Auto,
        "", "", "",
        LineStyle(
            graphics.Color(uint8(31), uint8(119), uint8(180), uint8(255)),
            2.0));
}

public ScatterStyle defaultScatterStyle() {
    return ScatterStyle(
        graphics.Color(uint8(31), uint8(119), uint8(180), uint8(255)),
        6.0);
}

public Figure2D figure(ref FigureOptions options) {
    if (!finite((*options).viewport.width) || !finite((*options).viewport.height) ||
        !((*options).viewport.width - 96.0 > 0.0) ||
        !((*options).viewport.height - 112.0 > 0.0)) {
        throw InvalidFigureException();
    }
    validateExplicit((*options).xLimits);
    validateExplicit((*options).yLimits);

    string ownedTitle = copyText(&(*options).title);
    string ownedXLabel = copyText(&(*options).xLabel);
    string ownedYLabel = copyText(&(*options).yLabel);
    Buffer<DataPoint> emptyPoints = Buffer<DataPoint>(0, DataPoint(0.0, 0.0));
    Buffer<SeriesRecord> emptySeries = Buffer<SeriesRecord>(
        0,
        SeriesRecord(
            SeriesKind.Line, 0, 0,
            uint8(0), uint8(0), uint8(0), uint8(0), 1.0));
    return Figure2D(
        FigureConstruction(0),
        emptyPoints, 0, 0,
        emptySeries, 0, 0,
        (*options).viewport, (*options).xLimits, (*options).yLimits,
        ownedTitle, ownedXLabel, ownedYLabel);
}

public Figure2D line(ref Array<DataPoint> points, ref FigureOptions options) {
    usize count = length(*points);
    if (count == 0) { throw EmptySeriesException(); }
    if (!finite((*options).viewport.width) || !finite((*options).viewport.height) ||
        !((*options).viewport.width - 96.0 > 0.0) ||
        !((*options).viewport.height - 112.0 > 0.0) ||
        !finite((*options).line.width) || !((*options).line.width > 0.0)) {
        throw InvalidFigureException();
    }
    validateExplicit((*options).xLimits);
    validateExplicit((*options).yLimits);

    Buffer<DataPoint> copied = Buffer<DataPoint>(count, DataPoint(0.0, 0.0));
    usize index = 0;
    bool foundFinite = false;
    while (index < count) {
        copied[index] = (*points)[index];
        if (finitePoint(copied[index])) { foundFinite = true; }
        index = index + 1;
    }
    if (!foundFinite) { throw NoFiniteDataException(); }

    Limits checkedX = resolveAxis(&copied, count, (*options).xLimits, true);
    Limits checkedY = resolveAxis(&copied, count, (*options).yLimits, false);

    string ownedTitle = copyText(&(*options).title);
    string ownedXLabel = copyText(&(*options).xLabel);
    string ownedYLabel = copyText(&(*options).yLabel);
    Buffer<SeriesRecord> copiedSeries = Buffer<SeriesRecord>(
        1,
        SeriesRecord(
            SeriesKind.Line, 0, count,
            (*options).line.color.red, (*options).line.color.green,
            (*options).line.color.blue, (*options).line.color.alpha,
            (*options).line.width));
    return Figure2D(
        FigureConstruction(0),
        copied, count, count,
        copiedSeries, 1, 1,
        (*options).viewport, (*options).xLimits, (*options).yLimits,
        ownedTitle, ownedXLabel, ownedYLabel);
}

public Figure2D plotFunction<C: Invocable<(float64), float64>>(
    ref C target,
    float64 a,
    float64 b,
    usize sampleCount,
    ref FigureOptions options) {
    if (sampleCount < 2) { throw InvalidSampleCountException(); }
    if (!finite(a) || !finite(b) || !(a < b)) {
        throw InvalidSampleIntervalException();
    }
    float64 span = b - a;
    if (!finite(span) || !(span > 0.0)) { throw PlotRangeException(); }

    Array<DataPoint> points = Array<DataPoint>(
        sampleCount, DataPoint(0.0, 0.0));
    usize denominator = sampleCount - 1;
    usize index = 0;
    while (index < sampleCount) {
        float64 x = a;
        if (index == denominator) {
            x = b;
        } else {
            if (index != 0) {
                float64 t = float64(index) / float64(denominator);
                x = a + span * t;
            }
        }
        if (!finite(x)) { throw PlotRangeException(); }
        float64 y = target(x);
        points[index] = DataPoint(x, y);
        index = index + 1;
    }
    return line(&points, options);
}

public void addFunction<C: Invocable<(float64), float64>>(
    Figure2D figure,
    ref C target,
    float64 a,
    float64 b,
    usize sampleCount,
    LineStyle style) {
    if (sampleCount < 2) { throw InvalidSampleCountException(); }
    if (!finite(a) || !finite(b) || !(a < b)) {
        throw InvalidSampleIntervalException();
    }
    float64 span = b - a;
    if (!finite(span) || !(span > 0.0)) { throw PlotRangeException(); }

    Array<DataPoint> points = Array<DataPoint>(
        sampleCount, DataPoint(0.0, 0.0));
    usize denominator = sampleCount - 1;
    usize index = 0;
    while (index < sampleCount) {
        float64 x = a;
        if (index == denominator) {
            x = b;
        } else {
            if (index != 0) {
                float64 t = float64(index) / float64(denominator);
                x = a + span * t;
            }
        }
        if (!finite(x)) { throw PlotRangeException(); }
        float64 y = target(x);
        points[index] = DataPoint(x, y);
        index = index + 1;
    }
    figure.addLine(&points, style);
}
