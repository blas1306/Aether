package main;

import provider;

public int plusOne(int value) {
    return value + 1;
}

public int main() {
    Function<(int),int> function = plusOne;
    int first = provider.forward(function,20);
    int offset = 1;
    var closure = (int value) capture(copy offset) => value + offset;
    int second = provider.forward(closure,20);
    int alive = closure(0);
    return first + second + alive - 43;
}
