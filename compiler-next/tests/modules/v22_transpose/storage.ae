package storage;

public Vector<T,Column> toColumn<T:Storable>(Vector<T,Row> v) { return transpose(v); }
public Vector<T,Row> toRow<T:Storable>(Vector<T,Column> v) { return transpose(v); }
public T identity<T:Storable>(T v) { return v; }
public int consume(Vector<Buffer<int>,Column> v) { return v[1][0]-42; }
