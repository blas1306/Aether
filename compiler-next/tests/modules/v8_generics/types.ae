package types;

public T identity<T>(T value) {
    return value;
}

public struct Pair<T, U> {
    T first;
    U second;
}

alias IntPair = Pair<int, int>;

enum Option<T> {
    None,
    Some(T),
}

public T first<T: Copy, U>(Pair<T, U> value) {
    return value.first;
}

public T unwrapOr<T>(Option<T> value, T fallback) {
    match (value) {
        Option<T>.None => { return fallback; }
        Option<T>.Some(found) => { return found; }
    }
}
