package storage;

public struct Packet {
    Array<int> values;
}

public Array<int> make() {
    Array<int> values = {10, 20, 3};
    return values;
}

public Packet wrap(Array<int> values) {
    return Packet(values);
}

public int consume(Packet packet) {
    return packet.values[0] + packet.values[1] + packet.values[2];
}
