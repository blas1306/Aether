package storage;

public struct Holder<T: Storable> { T value; }
public Vector<T,Row> row<T: Storable>(T a,T b) { return [a,b]; }
public Vector<T,Column> column<T: Storable>(T a,T b) { return [a,b]; }
public usize rowSize<T: Storable>(ref Vector<T,Row> v) { return dimension(*v); }
public int readColumn(ref Vector<int,Column> v,usize i) { return (*v)[i]; }
