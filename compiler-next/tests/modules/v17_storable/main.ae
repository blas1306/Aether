package main;

import storage;
public List<T> forwarded<T: Storable + Relocatable>(T value) { return storage.list<T>(value); }
public int main() {
    storage.Box<Buffer<int>> box = storage.Box<Buffer<int>>(storage.array(Buffer<int>(1, 20)));
    List<Buffer<int>> values = forwarded(Buffer<int>(1, 22));
    return box.values[0][0] + values[0][0];
}
