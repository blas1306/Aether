package helper;

public struct Pair { int x; int y; }

public Matrix<T> matrix<T:Storable+Copy>(usize rows,usize columns,T value) {
    return matrixFilled<T>(rows,columns,value);
}

public Vector<T,Row> row<T:Storable+Copy>(usize length,T value) {
    return vectorFilled<T,Row>(length,value);
}

public Vector<T,Column> column<T:Storable+Copy>(usize length,T value) {
    return vectorFilled<T,Column>(length,value);
}

