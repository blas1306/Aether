package storage;

public struct Packet {
    List<int> values;
}

public List<int> make() {
    List<int> values = {10, 20};
    push(values, 30);
    return values;
}

public Packet wrap(List<int> values) {
    return Packet(values);
}

public int consume(Packet packet) {
    return packet.values[0] + packet.values[2];
}
