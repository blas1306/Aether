int main() {
    Vector<Vector<int,Column>,Row> v=[[10,20,30],[40,50,60]];
    if (v[1][3]!=30) { return 1; }
    if (dimension(v[2])!=3) { return 2; }
    Array<Vector<int,Row>> a={[7,8,9]};
    List<Vector<int,Column>> l={[1,2]};
    reserve(l,4);
    if(a[0][3]!=9) { return 3; }
    if(l[0][2]!=2) { return 4; }
    Vector<Array<int>,Row> c=[{4,5,6}];
    c[1][2]=10;
    return c[1][2]-10;
}
