int main() {
    Matrix<int> a = [1,2,3;4,5,6];
    Matrix<int> b = [10,20,30;40,50,60];
    Matrix<int> c = a+b;
    Matrix<int> d = b-a;
    if(rows(c)!=2){return 1;}
    if(columns(c)!=3){return 2;}
    if(c[1,1]!=11){return 3;}
    if(c[1,3]!=33){return 4;}
    if(c[2,2]!=55){return 5;}
    if(d[2,3]!=54){return 6;}
    c[2,2]=99;
    return a[2,2]+b[2,2]-55;
}
