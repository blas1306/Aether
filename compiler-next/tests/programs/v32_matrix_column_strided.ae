int main(){
    Matrix<int>a=[1,2,3;4,5,6];
    Matrix<int>b=[2,9;3,8];
    MatrixView<int>t=transpose_view(a);
    VectorView<int,Column>x=column(b,1);
    Vector<int,Column>y=t*x;
    if(dimension(y)!=3){return 1;}
    if(y[1]!=14){return 2;}
    if(y[2]!=19){return 3;}
    if(y[3]!=24){return 4;}
    return 0;
}
