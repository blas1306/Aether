int main() {
    Vector<int,Row> a = [1,2,3];
    Vector<int,Row> b = [4,5,6];
    Vector<int,Row> sum = a+b;
    Vector<int,Row> difference = b-a;
    if (sum[1]!=5) {return 1;}
    if (sum[2]!=7) {return 2;}
    if (sum[3]!=9) {return 3;}
    if (difference[1]!=3) {return 4;}
    if (difference[3]!=3) {return 5;}
    sum[1]=90;
    return a[1]+b[1]-5;
}
