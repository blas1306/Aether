Vector<T,Column> apply<T:Storable+Copy+Add+Mul+Zero>(MatrixView<T>a,VectorView<T,Column>x){return a*x;}
Vector<T,Column> forward<T:Storable+Copy+Add+Mul+Zero>(MatrixView<T>a,VectorView<T,Column>x){return apply(a,x);}
int main(){Matrix<int>a=[1,2,3;4,5,6];Matrix<int>b=[2,9;3,8];MatrixView<int>t=transpose_view(a);VectorView<int,Column>x=column(b,1);Vector<int,Column>y=forward(t,x);if(y[3]!=24){return 1;}return 0;}
