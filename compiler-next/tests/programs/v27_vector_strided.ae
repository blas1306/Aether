int main() {
    Matrix<int> a = [1,2,3;4,5,6;7,8,9];
    Matrix<int> b = [10,20,30;40,50,60;70,80,90];
    VectorView<int,Column> av = column(a,2);
    VectorView<int,Column> bv = column(b,2);
    Vector<int,Column> c = av+bv;
    Vector<int,Row> r = row(a,3)+row(b,3);
    if(c[1]!=22){return 1;}
    if(c[2]!=55){return 2;}
    if(c[3]!=88){return 3;}
    if(r[1]!=77){return 4;}
    if(r[2]!=88){return 5;}
    if(r[3]!=99){return 6;}
    return a[2,2]+b[2,2]-55;
}
