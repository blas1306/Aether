int main() {
    List<int> values = {10,20,30,40};
    usize cap = capacity(values);
    ref int first = &values[0];
    ref int third = &values[2];
    int removed = swap_remove(values,1);
    if (removed != 20) { return 1; }
    if (length(values) != 3) { return 2; }
    if (capacity(values) != cap) { return 3; }
    if (*first != 10) { return 4; }
    if (values[1] != 40) { return 5; }
    if (*third != 30) { return 6; }
    return 0;
}
