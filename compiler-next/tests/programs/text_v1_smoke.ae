package text_v1_smoke;

import std.Text;

int main() {
    string value = "Aé€😀é\0Z";
    std.Text.ScalarOffset zero = std.Text.scalarOffset(0);
    if (std.Text.codePointCount(value) != 8) { return 1; }
    if (std.Text.contains(value, "€😀") == false) { return 2; }
    if (std.Text.startsWith(value, "Aé") == false) { return 3; }
    if (std.Text.endsWith(value, "\0Z") == false) { return 4; }
    match (std.Text.findFrom(value, "😀", zero)) {
        std.Text.FindResult.Found(at) => {
            if (at.value != 3) { return 5; }
        }
        std.Text.FindResult.NotFound => { return 6; }
    }
    match (std.Text.findFrom(value, "", std.Text.scalarOffset(8))) {
        std.Text.FindResult.Found(at) => {
            if (at.value != 8) { return 7; }
        }
        std.Text.FindResult.NotFound => { return 8; }
    }
    string middle = std.Text.substring(value, std.Text.scalarOffset(1), std.Text.scalarOffset(4));
    if (middle != "é€😀") { return 9; }
    string trimmed = std.Text.trim(" \t\n\rok \t");
    if (trimmed != "ok") { return 10; }
    string unicode_space = std.Text.trim(" ok ");
    if (unicode_space != " ok ") { return 11; }
    List<string> pieces = std.Text.split("a,,b,", ",");
    if (length(pieces) != 4) { return 12; }
    string p0 = remove(pieces, 0);
    string p1 = remove(pieces, 0);
    string p2 = remove(pieces, 0);
    string p3 = remove(pieces, 0);
    if (p0 != "a") { return 13; }
    if (p1 != "") { return 14; }
    if (p2 != "b") { return 15; }
    if (p3 != "") { return 16; }
    List<string> lines = std.Text.lines("first\r\nsecond\n");
    if (length(lines) != 2) { return 17; }
    string l0 = remove(lines, 0);
    string l1 = remove(lines, 0);
    if (l0 != "first") { return 18; }
    if (l1 != "second") { return 19; }
    return 0;
}
