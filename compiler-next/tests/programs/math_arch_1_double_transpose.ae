int main() {
    Matrix<int> a = [1,2,3;4,5,6];
    Matrix<int> b = [7,8;9,10;11,12];
    MatrixView<int> at = transpose_view(a);
    MatrixView<int> att = transpose_view(at);
    MatrixView<int> bt = transpose_view(b);
    MatrixView<int> btt = transpose_view(bt);
    Matrix<int> c = att * btt;
    if (rows(c) != 2) { return 1; }
    if (columns(c) != 2) { return 2; }
    if (c[1,1] != 58) { return 3; }
    if (c[1,2] != 64) { return 4; }
    if (c[2,1] != 139) { return 5; }
    if (c[2,2] != 154) { return 6; }
    c[1,1] = 0;
    if (a[1,1] != 1) { return 7; }
    if (b[1,1] != 7) { return 8; }
    return 0;
}
