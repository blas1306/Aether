struct Holder { Matrix<int> m; Vector<int,Row> v; }
int main() {
    Holder h=Holder([1,2;3,4],[5,6]);
    Matrix<int> m=h.m+h.m;
    Vector<int,Row> v=h.v-h.v;
    Array<Matrix<int>> a={ [10,20;30,40], [1,2;3,4] };
    Matrix<int> b=a[0]-a[1];
    ref Matrix<int> r=&h.m;
    Matrix<int> c=*r+*r;
    if(m[2,2]!=8){return 1;}
    if(v[1]!=0){return 2;}
    if(b[2,2]!=36){return 3;}
    return c[2,1]-6;
}
