struct Segment {
    Point start;
    Point end;
}

struct Point {
    float64 x;
    float64 y;
}

alias Position = Point;

Point translate(Point p, float64 dx, float64 dy) {
    p.x = p.x + dx;
    p.y = p.y + dy;
    return p;
}

Point choose(Point p, bool positive) {
    if (positive) {
        p.x = 9.0;
    } else {
        p.x = -9.0;
    }
    return p;
}

int main() {
    Segment original = Segment(Point(0.0, 0.0), Position(1.0, 1.0));
    float32 small = 2.0;
    Point widened = Point(small, 3.0);
    Point selected = choose(Point(0.0, 0.0), true);
    Segment copy = original;
    copy.start.x = 5.0;
    Position moved = translate(copy.start, 2.0, 3.0);
    if (original.start.x == 0.0) {
        if (copy.start.x == 5.0) {
            if (moved.x == 7.0) {
                if (widened.x == 2.0) {
                    if (selected.x == 9.0) {
                        return 42;
                    }
                }
            }
        }
    }
    return 0;
}
