interface Access {
    int get();
    mut int increment();
}
class Counter : Access {
    int value;
    public init(int value) { this.value = value; }
    public int get() { return value; }
    public mut int increment() { value = value + 1; return value; }
}
int main() {
    
    int n = 0;
    while (n < 10000) {
        Access i = Counter(0);
        n = n + 1;
    }
    return 0;
}
