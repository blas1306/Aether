Matrix<T> product<T:Storable+Copy+Mul>(VectorView<T,Column>c,VectorView<T,Row>r){return c*r;} Matrix<T> forward<T:Storable+Copy+Mul>(VectorView<T,Column>c,VectorView<T,Row>r){return product(c,r);} int main(){Matrix<int>a=[1,2,3;4,5,6];Matrix<int>b=[7,8;9,10;11,12];VectorView<int,Column>c=column(a,2);VectorView<int,Column>bc=column(b,1);VectorView<int,Row>r=transpose_view(bc);Matrix<int>m=forward(c,r);if(rows(m)!=2){return 1;}if(columns(m)!=3){return 2;}if(m[2,3]!=55){return 3;}return 0;}
