int main() {
    Vector<double,Column> a=[1.5,2.25];
    Vector<double,Column> b=[0.5,0.75];
    Vector<double,Column> c=a+b;
    Vector<float,Column> x=[4.5,8.25];
    Vector<float,Column> y=[1.5,2.25];
    Vector<float,Column> z=x-y;
    Matrix<double> m=[1.5,2.5,3.5;4.5,5.5,6.5];
    Matrix<double> n=m+m;
    if(c[1]!=2.0){return 1;}
    if(c[2]!=3.0){return 2;}
    if(z[1]!=3.0){return 3;}
    if(z[2]!=6.0){return 4;}
    if(n[2,3]!=13.0){return 5;}
    return 0;
}
