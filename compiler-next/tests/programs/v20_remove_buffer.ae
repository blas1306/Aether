int main() {
    List<Buffer<int>> values = {Buffer<int>(1,10),Buffer<int>(1,20),Buffer<int>(1,30),Buffer<int>(1,40)};
    Buffer<int> removed = remove(values,1);
    if (removed[0] != 20) { return 1; }
    if (values[0][0] != 10) { return 2; }
    if (values[1][0] != 30) { return 3; }
    if (values[2][0] != 40) { return 4; }
    return 0;
}
