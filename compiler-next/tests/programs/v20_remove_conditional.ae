int consume(Buffer<int> value) { return value[0]; }
int conditional(bool transfer) {
    List<Buffer<int>> values = {Buffer<int>(1,10),Buffer<int>(1,20)};
    Buffer<int> removed = remove(values,0);
    if (transfer) { int value = consume(removed); }
    return values[0][0] - 20;
}
int main() {
    int a = conditional(true);
    int b = conditional(false);
    List<Buffer<int>> values = {Buffer<int>(1,1),Buffer<int>(1,2),Buffer<int>(1,3)};
    int sum = 0;
    while(length(values)>0) { Buffer<int> removed = remove(values,0); sum = sum + removed[0]; }
    if (sum != 6) { return 1; }
    return a+b;
}
