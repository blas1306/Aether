Buffer<int> takeLast(ref mut List<Buffer<int>> values) { return pop(*values); }
int consume(Buffer<int> value) { return value[0]; }
int main() {
    List<Buffer<int>> values = {Buffer<int>(1, 10), Buffer<int>(1, 20), Buffer<int>(1, 30)};
    Buffer<int> last = takeLast(&mut values);
    if (last[0] != 30) { return 1; }
    if (consume(pop(values)) != 20) { return 2; }
    if (length(values) != 1) { return 3; }
    if (values[0][0] != 10) { return 4; }
    return 0;
}
