struct Dataset { Buffer<int> values; int count; }
struct Owner { List<Dataset> values; }
int main() {
    Owner owner = Owner({Dataset(Buffer<int>(1,10),1),Dataset(Buffer<int>(1,20),2),Dataset(Buffer<int>(1,30),3)});
    Dataset removed = remove(owner.values,0);
    if (removed.values[0] != 10) { return 1; }
    if (owner.values[0].values[0] != 20) { return 2; }
    if (owner.values[0].count != 2) { return 3; }
    Owner moved = owner;
    if (length(moved.values) != 2) { return 4; }
    return 0;
}
