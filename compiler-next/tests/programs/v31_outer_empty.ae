int main(){Vector<int,Column>c=[];Vector<int,Row>r=[];Vector<int,Column>cn=[2,3];Vector<int,Row>rn=[4,5,6];Matrix<int>a=c*r;Matrix<int>b=c*rn;Matrix<int>d=cn*r;if(rows(a)!=0){return 1;}if(columns(a)!=0){return 2;}if(rows(b)!=0){return 3;}if(columns(b)!=3){return 4;}if(rows(d)!=2){return 5;}if(columns(d)!=0){return 6;}VectorView<int,Row>rv=row(d,1);VectorView<int,Column>cv=column(b,2);if(rv*cv!=0){return 7;}Matrix<int>scaled=b*2;if(columns(scaled)!=3){return 8;}Matrix<int>sum=d+d;if(rows(sum)!=2){return 9;}return 0;}
