struct Holder { Matrix<int> m; }
int main() {
    Holder h = Holder([1,2;3,4]);
    VectorView<int,Row> r = row(h.m,2);
    Array<Matrix<int>> a = {[10,20;30,40]};
    VectorView<int,Column> c = column(a[0],2);
    List<Matrix<int>> l = {[5,6;7,8]};
    VectorViewMut<int,Row> w = row_mut(l[0],1);
    w[2] = 99;
    if (r[1] != 3) { return 1; }
    if (c[2] != 40) { return 2; }
    return l[0][1,2]-99;
}
