// Shared identity: mutation through b is visible through a.
class Counter {
    int value;
    public init(int value) { this.value = value; }
    public mut int increment() { value = value + 1; return value; }
    public int get() { return value; }
}
int main() {
    Counter a = Counter(0);
    Counter b = a;
    b.increment();
    if (a == b) { return a.get(); }
    return 99;
}
