int main() {
    List<int> values = {10,20,30,40};
    usize cap = capacity(values);
    int x = remove(values,3);
    if(x != 40) { return 1; }
    if(length(values) != 3) { return 2; }
    if(capacity(values) != cap) { return 3; }
    if(values[0] != 10) { return 4; }
    if(values[1] != 20) { return 5; }
    if(values[2] != 30) { return 6; }
    return 0;
}
