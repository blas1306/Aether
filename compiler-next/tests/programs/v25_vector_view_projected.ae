struct Holder{Vector<int,Row> v;}int main(){Holder h=Holder([1,2,3]);VectorView<int,Row> v=vector_view(h.v);VectorViewMut<int,Column> t=transpose_view_mut(h.v);t[3]=42;Array<Vector<int,Column>> a={[10,20]};VectorView<int,Row> u=transpose_view(a[0]);List<Vector<int,Row>> l={[5,6]};VectorViewMut<int,Row> w=vector_view_mut(l[0]);w[2]=99;return v[3]+u[2]+l[0][2]-161;}
