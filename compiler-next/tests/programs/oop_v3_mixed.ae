open class Animal{public init(){} public open int sound(){return 1;} public int age(){return 3;}}class Dog:Animal{public init():base(){} public override int sound(){return 7;}}class Cat:Animal{public override int sound(){return 9;}}int call(bool dog){Animal a=Dog();if(dog==false){a=Cat();}return a.sound();}int main(){return call(true)+call(false);}
