int main(){
Matrix<int> a=[1,2;3,4];MatrixView<int> t=transpose_view(a);
Matrix<int> b=2*t;Matrix<int> c=t*2;
if(b[1,1]!=2){return 1;}if(b[1,2]!=6){return 2;}if(b[2,1]!=4){return 3;}if(b[2,2]!=8){return 4;}
if(c[1,2]!=6){return 5;}if(c[2,1]!=4){return 6;}
Matrix<int> rect=[1,2,3;4,5,6];Matrix<int> d=2*transpose_view(rect);
if(rows(d)!=3){return 7;}if(columns(d)!=2){return 8;}if(d[2,2]!=10){return 9;}
return d[3,2]-12;
}
