double f(double x) = x*exp(x) - 1.0;
double df(double x) = exp(x) + x*exp(x);

double nr(double x0, double tol, int maxiter) {
    double x = x0;
    double res = abs(f(x));
    int iter = 0;
    
    for (i in 1:maxiter) {
        x = x - f(x)/df(x);
        res = abs(f(x));
        iter += 1;
        
        if (res < tol) {
            break;
        }
    }
    
    return x;
}

solNR = nr(1, 1e-8, 100);

double xn = solNR;

println("x = ", xn);
