struct Vec2 {
    double x;
    double y;
}

struct Particle {
    double mass;
    Vec2 position;
    Vec2 velocity;
}

int main() {
    Array<Particle> particles = {
        Particle(2.0, Vec2(1.0, 2.0), Vec2(0.5, -0.5)),
        Particle(3.0, Vec2(4.0, 5.0), Vec2(1.0, 1.5))
    };

    double totalMass = 0.0;
    for Particle particle in particles {
        totalMass = totalMass + particle.mass;
    }
    println(totalMass == 5.0);

    Particle first = particles[0];
    first.position.x = 9.0;

    // Reading copied the struct by value; the stored particle is unchanged
    // until an explicit indexed set writes the updated aggregate back.
    println(particles[0].position.x == 1.0);
    particles[0] = first;
    println(particles[0].position.x == 9.0);
    Array<Particle> copied = particles.copy();
    println(particles == copied);
    Particle copiedFirst = copied[0];
    copiedFirst.position.x = 42.0;
    copied[0] = copiedFirst;
    println(particles[0].position.x == 9.0);
    println(copied[0].position.x == 42.0);
    println(particles != copied);
    Array<Particle> sliced = particles[0:1];
    println(particles[0:1] == sliced);
    Particle slicedFirst = sliced[0];
    slicedFirst.position.x = 77.0;
    sliced[0] = slicedFirst;
    println(particles[0].position.x == 9.0);
    println(sliced[0].position.x == 77.0);
    println(particles.length == 2);
    return 0;
}
