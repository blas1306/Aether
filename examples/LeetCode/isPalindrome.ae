boolean isPalindrome(int x) {
    if (x < 0) {
        return false;
    }

    int original = x;
    int reversed = 0;

    while (x != 0) {
        int digit = x % 10;
        reversed = reversed * 10 + digit;
        x = int(x / 10);
    }

    return original == reversed;
}

int main() {
    int x = 121;

    if (isPalindrome(x)) {
        println(x, " is a palindrome.");
    } else {
        println(x, " is not a palindrome.");
    }

    return 0;
}