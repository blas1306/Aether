double dot(Array<double> a, Array<double> b) {
    if (length(a) != length(b)) {
        return 0.0;
    }

    double resultado = 0.0;

    usize i = 0;
    while (i < length(a)) {
        resultado = resultado + a[i] * b[i];
        i = i + 1;
    }

    return resultado;
}

int main() {
    Array<double> a = {1, 2, 3};
    Array<double> b = {4, 5, 6};

    double res = dot(a, b);
    println("dot result = ${res}");

    return 0;
}