from Transaction import Transaction;
from Transaction import TransactionType;

struct NativeSummary {
    double income;
    double expenses;
    double balance;
}

NativeSummary includeTransaction(NativeSummary current, Transaction transaction) {
    double income = current.income;
    double expenses = current.expenses;
    if transaction.type == TransactionType.Income {
        income = income + transaction.amount;
    } else {
        expenses = expenses + transaction.amount;
    }
    return NativeSummary(income, expenses, income - expenses);
}

Transaction incomeTransaction = Transaction(
    1,
    TransactionType.Income,
    "Salary",
    1500.0,
    "work",
    "2026-07-01"
);
Transaction expenseTransaction = Transaction(
    2,
    TransactionType.Expense,
    "Dinner",
    250.0,
    "food",
    "2026-07-15"
);
NativeSummary totals = includeTransaction(NativeSummary(0.0, 0.0, 0.0), incomeTransaction);
totals = includeTransaction(totals, expenseTransaction);

println("native enum in struct: ", expenseTransaction.type == TransactionType.Expense);
println("native string field: ", expenseTransaction.description);
println("native income: ", totals.income == 1500.0);
println("native expenses: ", totals.expenses == 250.0);
println("native balance: ", totals.balance == 1250.0);
