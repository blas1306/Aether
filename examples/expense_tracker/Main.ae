from Reports import Summary;
from Reports import filterByType;
from Reports import printTransactions;
from Reports import summarize;
from Reports import transactionLabel;
from Ledger import AddTransactionStatus;
from Ledger import addTransaction;
from Transaction import Transaction;
from Transaction import TransactionType;

List<Transaction> transactions = {};

string rawExpenseId = " 2 ";
string rawExpenseAmount = "\t250.0\n";
string rawDescription = "  Dinner  ";
string rawCategory = "\tfood\r";
IntParseResult parsedExpenseId = parseInt(rawExpenseId.trim());
DoubleParseResult parsedExpenseAmount = parseDouble(rawExpenseAmount.trim());
DoubleParseResult invalidParsedAmount = parseDouble(rawExpenseAmount);
int expenseId = 0;
double expenseAmount = 0.0;
if parsedExpenseId.status == ParseStatus.Success && parsedExpenseAmount.status == ParseStatus.Success {
    expenseId = parsedExpenseId.value;
    expenseAmount = parsedExpenseAmount.value;
}

AddTransactionStatus incomeStatus = addTransaction(
    transactions,
    1,
    TransactionType.Income,
    "Salary",
    1500.0,
    "work",
    "2026-07-01"
);
AddTransactionStatus expenseStatus = addTransaction(
    transactions,
    expenseId,
    TransactionType.Expense,
    rawDescription.trim(),
    expenseAmount,
    rawCategory.trim(),
    "2026-07-15"
);
AddTransactionStatus invalidStatus = addTransaction(
    transactions,
    3,
    TransactionType.Expense,
    "Invalid",
    0.0,
    "test",
    "2026-07-15"
);

Summary totals = summarize(transactions);
List<Transaction> expenses = filterByType(transactions, TransactionType.Expense);
List<Transaction> transactionCopy = transactions.copy();
boolean copyEquality = transactions == transactionCopy;
boolean sliceEquality = transactions == transactions[0:2];
boolean containsTransaction = transactions.contains(Transaction(
    expenseId,
    TransactionType.Expense,
    "Dinner",
    expenseAmount,
    "food",
    "2026-07-15"
));
boolean indexTransaction = transactions.indexOf(Transaction(
    expenseId,
    TransactionType.Expense,
    "Dinner",
    expenseAmount,
    "food",
    "2026-07-15"
)) == 1;
Transaction editedCopy = transactionCopy[0];
editedCopy.amount = 999.0;
transactionCopy[0] = editedCopy;
List<Transaction> transactionSlice = transactions[0:1];
Transaction editedSlice = transactionSlice[0];
editedSlice.amount = 777.0;
transactionSlice[0] = editedSlice;
List<Transaction> empty = {};
Summary emptyTotals = summarize(empty);
string expenseLabel = transactionLabel(expenses[0]);

println("income added: ", incomeStatus == AddTransactionStatus.Added);
println("numeric strings parsed: ", parsedExpenseId.status == ParseStatus.Success && parsedExpenseAmount.status == ParseStatus.Success);
println("invalid amount handled: ", invalidParsedAmount.status == ParseStatus.InvalidFormat);
println("expense added: ", expenseStatus == AddTransactionStatus.Added);
println("non-positive rejected: ", invalidStatus == AddTransactionStatus.NonPositiveAmount);
println("two transactions: ", transactions.length == 2);
println("income total: ", totals.income == 1500.0);
println("expense total: ", totals.expenses == 250.0);
println("balance: ", totals.balance == 1250.0);
println("expense filter: ", expenses.length == 1 && expenses[0].type == TransactionType.Expense);
println("copy equality: ", copyEquality);
println("slice equality: ", sliceEquality);
println("contains transaction: ", containsTransaction);
println("index transaction: ", indexTransaction);
println("copy independent: ", transactions[0].amount == 1500.0 && transactionCopy[0].amount == 999.0);
println("slice independent: ", transactions[0].amount == 1500.0 && transactionSlice[0].amount == 777.0);
println("empty summary: ", emptyTotals.balance == 0.0);
println("dynamic label: ", expenseLabel == "food: Dinner");
println("label byte length: ", expenseLabel.byteLength == 12);
println("transactions:");
printTransactions(transactions);
