from Reports import Summary;
from Reports import filterByType;
from Reports import printTransactions;
from Reports import summarize;
from Reports import transactionLabel;
from Ledger import AddTransactionStatus;
from Ledger import addTransaction;
from Transaction import Transaction;
from Transaction import TransactionType;
from Persistence import LedgerLoadResult;
from Persistence import LedgerStatus;
from Persistence import loadLedger;
from Persistence import saveLedger;
import System;
import io;

void runDemo() {
List<Transaction> transactions = {};

string rawExpenseId = " 2 ";
string rawExpenseAmount = "\t250.0\n";
string rawDescription = "  Dinner  ";
string rawCategory = "\tfood\r";
IntParseResult parsedExpenseId = parseInt(rawExpenseId.trim());
DoubleParseResult parsedExpenseAmount = parseDouble(rawExpenseAmount.trim());
DoubleParseResult invalidParsedAmount = parseDouble(rawExpenseAmount);
int expenseId = 0;
double expenseAmount = 0.0;
if parsedExpenseId.status == ParseStatus.Success && parsedExpenseAmount.status == ParseStatus.Success {
    expenseId = parsedExpenseId.value;
    expenseAmount = parsedExpenseAmount.value;
}

AddTransactionStatus incomeStatus = addTransaction(
    transactions,
    1,
    TransactionType.Income,
    "Salary",
    1500.0,
    "work",
    "2026-07-01"
);
AddTransactionStatus expenseStatus = addTransaction(
    transactions,
    expenseId,
    TransactionType.Expense,
    rawDescription.trim(),
    expenseAmount,
    rawCategory.trim(),
    "2026-07-15"
);
AddTransactionStatus invalidStatus = addTransaction(
    transactions,
    3,
    TransactionType.Expense,
    "Invalid",
    0.0,
    "test",
    "2026-07-15"
);

Summary totals = summarize(transactions);
List<Transaction> expenses = filterByType(transactions, TransactionType.Expense);
List<Transaction> transactionCopy = transactions.copy();
boolean copyEquality = transactions == transactionCopy;
boolean sliceEquality = transactions == transactions[0:2];
boolean containsTransaction = transactions.contains(Transaction(
    expenseId,
    TransactionType.Expense,
    "Dinner",
    expenseAmount,
    "food",
    "2026-07-15"
));
boolean indexTransaction = transactions.indexOf(Transaction(
    expenseId,
    TransactionType.Expense,
    "Dinner",
    expenseAmount,
    "food",
    "2026-07-15"
)) == 1;
Transaction editedCopy = transactionCopy[0];
editedCopy.amount = 999.0;
transactionCopy[0] = editedCopy;
List<Transaction> transactionSlice = transactions[0:1];
Transaction editedSlice = transactionSlice[0];
editedSlice.amount = 777.0;
transactionSlice[0] = editedSlice;
List<Transaction> empty = {};
Summary emptyTotals = summarize(empty);
string expenseLabel = transactionLabel(expenses[0]);

println("income added: ", incomeStatus == AddTransactionStatus.Added);
println("numeric strings parsed: ", parsedExpenseId.status == ParseStatus.Success && parsedExpenseAmount.status == ParseStatus.Success);
println("invalid amount handled: ", invalidParsedAmount.status == ParseStatus.InvalidFormat);
println("expense added: ", expenseStatus == AddTransactionStatus.Added);
println("non-positive rejected: ", invalidStatus == AddTransactionStatus.NonPositiveAmount);
println("two transactions: ", transactions.length == 2);
println("income total: ", totals.income == 1500.0);
println("expense total: ", totals.expenses == 250.0);
println("balance: ", totals.balance == 1250.0);
println("expense filter: ", expenses.length == 1 && expenses[0].type == TransactionType.Expense);
println("copy equality: ", copyEquality);
println("slice equality: ", sliceEquality);
println("contains transaction: ", containsTransaction);
println("index transaction: ", indexTransaction);
println("copy independent: ", transactions[0].amount == 1500.0 && transactionCopy[0].amount == 999.0);
println("slice independent: ", transactions[0].amount == 1500.0 && transactionSlice[0].amount == 777.0);
println("empty summary: ", emptyTotals.balance == 0.0);
println("dynamic label: ", expenseLabel == "food: Dinner");
println("label byte length: ", expenseLabel.byteLength == 12);
println("transactions:");
printTransactions(transactions);
}

List<Transaction> demoTransactions() {
    List<Transaction> transactions = {};
    addTransaction(transactions, 1, TransactionType.Income, "Salary", 1500.0, "work", "2026-07-01");
    addTransaction(transactions, 2, TransactionType.Expense, "Dinner", 250.0, "food", "2026-07-15");
    return transactions;
}

int runUtilityCommand(Array<string> args) {
    if args[0] == "split-check" {
        if args.length < 3 {
            println("insufficient arguments: split-check <separator> <text>");
            return 2;
        }
        Array<string> parts = args[2].split(args[1]);
        println("split parts: ", parts.length);
        for string part in parts {
            println(part);
        }
        return 0;
    }
    if args[0] == "persist-check" {
        if args.length < 2 {
            println("insufficient arguments: persist-check <path>");
            return 2;
        }
        string summary = "income=1500.0\nexpenses=250.0\nbalance=1250.0\n";
        FileStatus written = io.writeText(args[1], summary);
        if written != FileStatus.Success {
            println("summary write failed: ", written);
            return 2;
        }
        FileReadResult loaded = io.readText(args[1]);
        if loaded.status != FileStatus.Success || loaded.content != summary {
            println("summary verification failed: ", loaded.status);
            return 2;
        }
        FileStatus appended = io.appendText(args[1], "verified\n");
        if appended != FileStatus.Success {
            println("summary append failed: ", appended);
            return 2;
        }
        println("summary persisted and verified: true");
        return 0;
    }
    println("unknown command: ", args[0]);
    return 2;
}

LedgerLoadResult loadForCommand(string path) {
    LedgerLoadResult loaded = loadLedger(path);
    if loaded.status == LedgerStatus.FileNotFound {
        List<Transaction> empty = {};
        return LedgerLoadResult(empty, LedgerStatus.Success, 0);
    }
    return loaded;
}

int reportLoadFailure(LedgerLoadResult loaded) {
    println("ledger load failed: ", loaded.status, " at byte ", loaded.byteOffset);
    return 3;
}

int runPersistentCommand(Array<string> args) {
    if args.length < 2 {
        println("usage: <ledger.alpt> <add|list|summary> ...");
        return 2;
    }
    LedgerLoadResult loaded = loadForCommand(args[0]);
    if loaded.status != LedgerStatus.Success {
        return reportLoadFailure(loaded);
    }

    if args[1] == "list" {
        if args.length != 2 {
            println("invalid arguments: <ledger.alpt> list");
            return 2;
        }
        printTransactions(loaded.transactions);
        return 0;
    }
    if args[1] == "summary" {
        if args.length != 2 {
            println("invalid arguments: <ledger.alpt> summary");
            return 2;
        }
        Summary totals = summarize(loaded.transactions);
        println("income: ", totals.income);
        println("expenses: ", totals.expenses);
        println("balance: ", totals.balance);
        return 0;
    }
    if args[1] == "add" {
        if args.length < 8 {
            println("insufficient arguments: <ledger.alpt> add <expense|income> <id> <amount> <category> <description> <date>");
            return 2;
        }
        IntParseResult parsedId = parseInt(args[3].trim());
        if parsedId.status != ParseStatus.Success {
            println("invalid ID: ", args[3]);
            return 2;
        }
        DoubleParseResult parsedAmount = parseDouble(args[4].trim());
        if parsedAmount.status != ParseStatus.Success || parsedAmount.value <= 0.0 ||
            parsedAmount.value - parsedAmount.value != 0.0 {
            println("invalid amount: ", args[4]);
            return 2;
        }
        TransactionType type = TransactionType.Expense;
        if args[2] == "income" {
            type = TransactionType.Income;
        } else {
            if args[2] != "expense" {
                println("unknown transaction type: ", args[2]);
                return 2;
            }
        }
        AddTransactionStatus status = addTransaction(
            loaded.transactions, parsedId.value, type, args[6], parsedAmount.value,
            args[5], args[7]
        );
        if status != AddTransactionStatus.Added {
            println("invalid amount: ", args[4]);
            return 2;
        }
        LedgerStatus saved = saveLedger(args[0], loaded.transactions);
        if saved != LedgerStatus.Success {
            println("ledger save failed: ", saved);
            return 4;
        }
        println("transaction added: ", transactionLabel(
            loaded.transactions[loaded.transactions.length - 1]
        ));
        return 0;
    }
    println("unknown command: ", args[1]);
    return 2;
}

int main() {
    Array<string> args = System.args();
    if args.length == 0 {
        runDemo();
        return 0;
    }
    if args[0] == "split-check" || args[0] == "persist-check" {
        return runUtilityCommand(args);
    }
    return runPersistentCommand(args);
}
