package expense_tracker.ledger;

import expense_tracker.model;

enum AddTransactionStatus {
    Added,
    NonPositiveAmount,
}

AddTransactionStatus addTransaction(
    ref mut expense_tracker.model.Ledger ledger,
    int id,
    expense_tracker.model.TransactionType type,
    double amount,
    string category,
    string description,
    string date
) {
    if (amount <= 0.0 || amount - amount != 0.0) {
        return AddTransactionStatus.NonPositiveAmount;
    }
    push(
        (*ledger).transactions,
        expense_tracker.model.Transaction(id, type, amount, category, description, date)
    );
    return AddTransactionStatus.Added;
}
