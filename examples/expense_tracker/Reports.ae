package expense_tracker.reports;

import expense_tracker.model;

struct Summary {
    double income;
    double expenses;
    double balance;
}

Summary summarize(ref expense_tracker.model.Ledger ledger) {
    double income = 0.0;
    double expenses = 0.0;
    for (ref expense_tracker.model.Transaction transaction in (*ledger).transactions) {
        if ((*transaction).type == expense_tracker.model.TransactionType.Income) {
            income = income + (*transaction).amount;
        } else {
            expenses = expenses + (*transaction).amount;
        }
    }
    return Summary(income, expenses, income - expenses);
}

string transactionLabel(ref expense_tracker.model.Transaction transaction) {
    string label = "" + (*transaction).category;
    label = label + ": ";
    return label + (*transaction).description;
}

string transactionTypeLabel(expense_tracker.model.TransactionType type) {
    if (type == expense_tracker.model.TransactionType.Income) { return "Income"; }
    return "Expense";
}

void printTransactions(ref expense_tracker.model.Ledger ledger) {
    for (ref expense_tracker.model.Transaction transaction in (*ledger).transactions) {
        string typeLabel = transactionTypeLabel((*transaction).type);
        string line = "#" + str((*transaction).id);
        line = line + " | ";
        line = line + typeLabel;
        line = line + " | ";
        line = line + (*transaction).date;
        line = line + " | ";
        line = line + (*transaction).category;
        line = line + " | ";
        line = line + (*transaction).description;
        line = line + " | ";
        line = line + str((*transaction).amount);
        println(line);
    }
}
