boolean esPrimo2(int p) {
	if (p == 2 || p == 3) {
		return true;
	}

	int cota = int(sqrt(p));
	List<int> primosMenores = {2};

	if (p % 2 == 0) {
		return false;
	}

	for (int i in 3:2:cota) {
		primosMenores.push(i);
	}

	println(primosMenores);

	for (int primo in primosMenores) {
		if (p % primo == 0) {
			return false;
		}
	}

	return true;
}

int main() {
	println(esPrimo2(97));
	return 0;
}
