import Sortings

int main() {
    Array<int> arr = {5, 2, 3, 8, 1, 10, 9};

    if validarArray(arr) != true {
        return 1;
    } else {
        arrayBubble = bubbleSort(arr);
        arraySelection = selectionSort(arr);
        arrayInsertion = insertionSort(arr);

        println("BubbleSort: ", arrayBubble);
        println("SelectionSort: ", arraySelection);
        println("InsertionSort: ", arrayInsertion);
    }
}