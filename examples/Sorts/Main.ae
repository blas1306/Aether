import Sortings;

int main() {
    Array<int> arr = {5, 2, 3, 8, 1, 10, 9};

    Array<int> arrayBubble = Sortings.bubbleSort(arr);
    Array<int> arraySelection = Sortings.selectionSort(arr);
    Array<int> arrayInsertion = Sortings.insertionSort(arr);

    println("BubbleSort:    ", arrayBubble);
    println("SelectionSort: ", arraySelection);
    println("InsertionSort: ", arrayInsertion);
}
