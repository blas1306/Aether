private void swap(Array<int> arr, int i, int j) {
    int aux = arr[i];
    arr[i] = arr[j];
    arr[j] = aux;
}

// BubbleSort
public Array<int> bubbleSort(Array<int> arr) {
    Array<int> nuevoArray = arr.copy();
    int n = nuevoArray.length;
    boolean huboIntercambio = true;

    for (pasada in 0:(n-2)) {
        huboIntercambio = false;

        for (j in 0:(n-2-pasada)) {
            if (nuevoArray[j] > nuevoArray[j+1]) {
                swap(nuevoArray, j, j + 1);
                huboIntercambio = true;
            }
        }
    }

    return nuevoArray;
}

// SelectionSort
public Array<int> selectionSort(Array<int> arr) {
    Array<int> nuevoArray = arr.copy();
    int n = nuevoArray.length;
    for (i in 0:(n-2)) {
        int indiceMinimo = i;

        for (j in (i+1):(n-1)) {
            if (nuevoArray[j] < nuevoArray[indiceMinimo]) {
                indiceMinimo = j;
            }
        }

        if (indiceMinimo != i) {
            swap(nuevoArray, i, indiceMinimo);
        }
    }

    return nuevoArray;
}

// InsertionSort
public Array<int> insertionSort(Array<int> arr) {
    Array<int> nuevoArray = arr.copy();
    int n = nuevoArray.length;

    for (i in 1:(n-1)) {
        int actual = nuevoArray[i];
        int j = i - 1;

        while (j >= 0 && nuevoArray[j] > actual) {
            nuevoArray[j + 1] = nuevoArray[j];
            j = j - 1;
        }

        nuevoArray[j + 1] = actual;
    }

    return nuevoArray;
}
