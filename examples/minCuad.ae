import Math.LinearAlgebra as la;
import Plots as pl;

Vector<double, Column> x = [1, 2, 3, 4];
Vector<double, Column> y = [1, 4, 9, 16];

Array<double> modelo(double x) {
    return {1, x};
}

int m = x.length;
int n = base;

Matrix<double> A = la.zeros(m, 2);

for (int i in 1:m) {
    A[1:m, 2] = 1;
}

Vector<double, Column> z = A \ y;

f(double t) = z[1] * t + z[2];
err = LA.norm(A * z - y);

println("Coefficients: ", z);
println("Error: ", err);

pl.hold(true);
pl.grid(true);
pl.plot(x, y, "o");
pl.plot(f, 0, 5);
pl.legend("Datos", "Ajuste");
pl.title("Minimos Cuadrados");
