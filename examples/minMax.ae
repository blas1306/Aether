double min(ref Vector<double, Column> t) {
    Vector<double, Column>& tt = t;
    double min = tt[1];

    for (int i in 2:int(dimension(tt))) {
        if (tt[usize(i)] < min) {
            min = tt[usize(i)];
        }
    }

    return min;
}

double min(Vector<double, Row> t) {
    double min = t[1];

    for (int i in 2:int(dimension(t))) {
        if (t[usize(i)] < min) {
            min = t[usize(i)];
        }
    }

    return min;
}

double max(Vector<double, Column> t) {
    Vector<double, Column>& tt = t;
    double max = tt[1];

    for (int i in 2:int(dimension(tt))) {
        if (tt[usize(i)] > max) {
            max = tt[usize(i)];
        }
    }

    return max;
}

double max(Vector<double, Row> t) {
    double max = t[1];

    for (int i in 2:int(dimension(t))) {
        if (t[usize(i)] > max) {
            max = t[usize(i)];
        }
    }

    return max;
}

int main() {
    Vector<double, Column> t = [-2, -1, 0, -4, 2];

    println("min = ${min(t)}");
    println("max = ${max(t)}");

    return 0;
}