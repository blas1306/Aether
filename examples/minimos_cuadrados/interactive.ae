import Math.LinearAlgebra
import Plots

Vector<double> MinCuad() {
    Vector<double> t = input("Ingrese el vector t: ");
    Vector<double> y = input("Ingrese el vector y: ");

    st = size(t);
    sy = size(y);

    mt = st[0];
    my = sy[0];

    if (mt != my) {
        println("Los vectores no tienen la mismas dimensiones. Intente nuevamente");
    }

    A = Math.LinearAlgebra.zeros(mt, 2);

    z = A \ y;

    f(x) = z[0] + z[1]*x;

    Plots.grid(true);
    Plots.title("Numeros primos y ajuste");
    Plots.xlabel("t");
    Plots.ylabel("y");
    Plots.plot(t, y, ".", label="Datos", color="red");
    Plots.plot!(f, z[0]-1, z[1]+1, label="Ajuste");

    err2 = Math.LinearAlgebra.norm(y - A*z)^2;
    println("err2 = ", err2);

    return z;
}

MinCuad();