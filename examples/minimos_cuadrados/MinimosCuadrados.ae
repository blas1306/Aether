import linearAlgebra as la;
import plots as plt;

void MinimosCuadrados(Vector<double, Column> t, Vector<double, Column> y, Function<(double), Vector<double, Column>> modelo) {

    Matrix<double> A = la.zeros(t.length, modelo.length);

    for (int i in 1:t.length) {
        for (int j in 1:modelo.length) {
            A[i, j] = modelo[j](t[i]);
        }
    }

    var theta = la.leastSquares(A, y);
    println("Coeficientes modelo: ${theta}");

    var g = (double x) => la.dot(theta, modelo);

    var fig = plt.scatter(t, y);
    plt.plot!(g, min(t), max(t), 300); // la cantidad de puntos podemos hacer que sea 300 el default parameter
    plt.show();
}

int main() {
    Vector<double, Column> t = [-2, -1, 0, 1, 2];
    Vector<double, Column> y = [5, 2, 1, 3, 5];

    var modelo = (double x) => [1; x; x*x];

    MinimosCuadrados(t, y, modelo);

    return 0;
}
