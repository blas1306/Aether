import Math.LinearAlgebra

Vector<double> t = [1, 2, 3, 4];
Vector<double> y = [3, 7, 8, 10];
Vector<double> base(double x) {
    yt = [1, x, x^2];
    return yt;
}

(Vector<double> z, double f) MinimosCuadrados(Vector<double> t, Vector<double> y, double x) {
    st = size(t);
    sy = size(y);
    sbase = size(base(x));

    mt = st[0];
    my = sy[0];
    mbase = sbase[0];

    A = zeros(mt, mbase);

    for i in 0:(mt - 1) {
        for j in 0:(mbase - 1) {
            A[i, j] = base(y[i])[j];
        }
    }

    z = A \ y;

    double f = 0;

    for j in 0:(mbase - 1) {
        f = f + z[j]*base(x)[j];
    }

    return (z, f);
}

coef, modelo = MinimosCuadrados(t, y, 4);

println("z = ", coef);
println("y(t) = ", modelo);