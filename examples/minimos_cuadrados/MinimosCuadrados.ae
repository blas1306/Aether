import linearAlgebra as la;

struct MinCuad {
    Vector<double, Column> a;
    double E;
}

double modelo(int j, double t) {
    if (j == 1) {
        return t * t;
    } else if (j == 2) {
        return t;
    } else {
        return 1.0;
    }
}

MinCuad MinimosCuadrados(Vector<double, Column> t, Vector<double, Column> y, int n, Function<(int, double), double> phi) {
    int m = t.length;

    Matrix<double> A = la.zeros(m, n);

    for (int i in 1:n) {
        for (int j in 1:n) {
            A[i, j] = phi(j, t[i]);
        }
    }

    Vector<double, Column> a = la.leastSquares(A, y);

    Vector<double, Column> r = A*a - y;
    double E = la.dot(r, r);

    return MinCuad(a, E);
}

double evualuarModelo(double x. Vector<double, Column> a, Function<(int, double), double> phi) {
    double resultado = 0.0;

    for (int j in 1:a.length) {
        resultado = resultado + a[j]*phi(j, x);
    }

    return resultado;
}

