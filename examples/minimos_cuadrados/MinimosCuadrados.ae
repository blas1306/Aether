import Math.LinearAlgebra
import Plots

Vector<double> t = [2, 3, 4, 5, 6];
Vector<double> y = [3, 5, 7, 11, 13];
Vector<double> base(double x) {
    yt = [1, x*ln(x)];
    return yt;
}

st = size(t);
sy = size(y);
sbase = size(base(1));

mt = st[0];
my = sy[0];
mbase = sbase[0];

A = Math.LinearAlgebra.zeros(mt, mbase);

for i in 0:(mt - 1) {
    for j in 0:(mbase - 1) {
        A[i, j] = base(t[i])[j];
    }
}

z = A \ y;

double modelo(double x) {
    double acc = 0;

    for j in 0:(mbase - 1) {
        acc = acc + z[j]*base(x)[j];
    }

    return acc;
}

println("z = ", z);

err2 = Math.LinearAlgebra.norm(y - A*z)^2;
println("err2 = ", err2);

Plots.grid(true);
Plots.title("Minimos Cuadrados");
Plots.xlabel("t");
Plots.ylabel("y");
Plots.plot(t, y, ".", label="Datos", color="red");
Plots.plot!(modelo, t[0]-1, t[mt-1]+1, label="Ajuste");

println(modelo(8));