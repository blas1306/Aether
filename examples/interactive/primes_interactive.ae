boolean esPrimo3(int p) {
    if p == 2 || p == 3 {
        return true;
    }

    int cota = int(sqrt(p));

    for i in 2:cota {
        if p % i == 0 {
            return false;
        }
    }

    return true;
}

while true {
    int p = input("Ingrese un numero positivo: ");

    if p <= 1 {
        println("Numero invalido. Ingrese un numero nuevamente");
    }

    if esPrimo3(p) == false {
        println("El numero $p$ no es primo");
    } else {
        println("El numero $p$ es primo");
    }
}
