import Math.LinearAlgebra as LA
import Plots as pl

Matrix<double> A(Vector<double, Column> x) {
    Matrix<double> A = [x[2] + 1, 1; x[1], -x[2]];
    return A;
}

Vector<double, Column> c = [69, 45];

Vector<double, Column> x0 = [8, 6];
double tol = 1e-8;
int maxiter = 100;

Vector<double, Column> x = x0;
Vector<double, Column> residual = A(x) * x - c;
double res = LA.norm(residual);
int iter = 0;

while (res > tol && iter < maxiter) {
    Vector<double, Column> z = A(x) \ c;
    x = x + z;
    residual = A(x) * x - c;
    res = LA.norm(residual);
    iter += 1;
}

println("x = ", x);
println("res = ", res);
println("iter = ", iter);

f1(double x) = 11 - x^2;
f2(double x) = sqrt(7 - x);

pl.hold(true);
pl.grid(true);
pl.plot(f1, -5, 5);
pl.plot(f2, -5, 5);