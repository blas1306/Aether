package Roots;

import Functions;
import Results;

Results.RootResult bisection(
    Functions.ScalarCallable target,
    double left,
    double right,
    double tolerance,
    int maxIterations
) {
    if (tolerance <= 0.0 || maxIterations <= 0 || left >= right) {
        return Results.RootResult((left + right) / 2.0, 0, Results.RootStatus.InvalidInterval);
    }

    double fLeft = target(left);
    double fRight = target(right);
    if (abs(fLeft) <= tolerance) {
        return Results.RootResult(left, 0, Results.RootStatus.Converged);
    }
    if (abs(fRight) <= tolerance) {
        return Results.RootResult(right, 0, Results.RootStatus.Converged);
    }
    if (fLeft * fRight > 0.0) {
        return Results.RootResult((left + right) / 2.0, 0, Results.RootStatus.InvalidInterval);
    }

    int iterations = 0;
    double middle = (left + right) / 2.0;
    while (iterations < maxIterations) {
        middle = (left + right) / 2.0;
        double fMiddle = target(middle);
        iterations = iterations + 1;

        if (abs(fMiddle) <= tolerance || abs(right - left) / 2.0 <= tolerance) {
            return Results.RootResult(middle, iterations, Results.RootStatus.Converged);
        }
        if (fLeft * fMiddle < 0.0) {
            right = middle;
        } else {
            left = middle;
            fLeft = fMiddle;
        }
    }
    return Results.RootResult(middle, iterations, Results.RootStatus.MaxIterations);
}

Results.RootResult newton(
    Functions.ScalarCallable target,
    Functions.ScalarCallable derivative,
    double initial,
    double tolerance,
    int maxIterations
) {
    if (tolerance <= 0.0 || maxIterations <= 0) {
        return Results.RootResult(initial, 0, Results.RootStatus.InvalidInterval);
    }

    double x = initial;
    int iterations = 0;
    while (iterations < maxIterations) {
        double fx = target(x);
        if (abs(fx) <= tolerance) {
            return Results.RootResult(x, iterations, Results.RootStatus.Converged);
        }

        double slope = derivative(x);
        if (abs(slope) <= tolerance) {
            return Results.RootResult(x, iterations, Results.RootStatus.ZeroDerivative);
        }

        x = x - fx / slope;
        iterations = iterations + 1;
    }
    if (abs(target(x)) <= tolerance) {
        return Results.RootResult(x, iterations, Results.RootStatus.Converged);
    }
    return Results.RootResult(x, iterations, Results.RootStatus.MaxIterations);
}

Results.RootResult secant(
    Functions.ScalarCallable target,
    double previous,
    double current,
    double tolerance,
    int maxIterations
) {
    if (tolerance <= 0.0 || maxIterations <= 0) {
        return Results.RootResult(current, 0, Results.RootStatus.InvalidInterval);
    }

    double fPrevious = target(previous);
    double fCurrent = target(current);
    int iterations = 0;
    while (iterations < maxIterations) {
        if (abs(fCurrent) <= tolerance) {
            return Results.RootResult(current, iterations, Results.RootStatus.Converged);
        }

        double denominator = fCurrent - fPrevious;
        if (abs(denominator) <= tolerance) {
            return Results.RootResult(current, iterations, Results.RootStatus.ZeroDerivative);
        }

        double next = current - fCurrent * (current - previous) / denominator;
        previous = current;
        fPrevious = fCurrent;
        current = next;
        fCurrent = target(current);
        iterations = iterations + 1;
    }
    if (abs(fCurrent) <= tolerance) {
        return Results.RootResult(current, iterations, Results.RootStatus.Converged);
    }
    return Results.RootResult(current, iterations, Results.RootStatus.MaxIterations);
}
