package Integration;

import Functions;
import Results;

Results.IntegrationResult trapezoid(
    Functions.ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if (intervals <= 0) {
        return Results.IntegrationResult(0.0, Results.IntegrationStatus.NonPositiveSubintervalCount);
    }

    double step = (right - left) / double(intervals);
    double total = (target(left) + target(right)) / 2.0;
    int index = 1;
    while (index < intervals) {
        total = total + target(left + double(index) * step);
        index = index + 1;
    }
    return Results.IntegrationResult(total * step, Results.IntegrationStatus.Success);
}

Results.IntegrationResult simpson(
    Functions.ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if (intervals <= 0) {
        return Results.IntegrationResult(0.0, Results.IntegrationStatus.NonPositiveSubintervalCount);
    }
    if (intervals % 2 != 0) {
        return Results.IntegrationResult(0.0, Results.IntegrationStatus.SimpsonRequiresEvenSubintervals);
    }

    double step = (right - left) / double(intervals);
    double total = target(left) + target(right);
    int index = 1;
    while (index < intervals) {
        double weight = 2.0;
        if (index % 2 != 0) {
            weight = 4.0;
        }
        total = total + weight * target(left + double(index) * step);
        index = index + 1;
    }
    return Results.IntegrationResult(total * step / 3.0, Results.IntegrationStatus.Success);
}
