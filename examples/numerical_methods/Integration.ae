package Integration;

from Functions import ScalarCallable;
from Results import IntegrationResult;
from Results import IntegrationStatus;

public IntegrationResult trapezoid(
    ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if intervals <= 0 {
        return IntegrationResult(0.0, IntegrationStatus.NonPositiveSubintervalCount);
    }

    double step = (right - left) / double(intervals);
    double total = (target(left) + target(right)) / 2.0;
    int index = 1;
    while index < intervals {
        total = total + target(left + double(index) * step);
        index = index + 1;
    }
    return IntegrationResult(total * step, IntegrationStatus.Success);
}

public IntegrationResult simpson(
    ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if intervals <= 0 {
        return IntegrationResult(0.0, IntegrationStatus.NonPositiveSubintervalCount);
    }
    if intervals % 2 != 0 {
        return IntegrationResult(0.0, IntegrationStatus.SimpsonRequiresEvenSubintervals);
    }

    double step = (right - left) / double(intervals);
    double total = target(left) + target(right);
    int index = 1;
    while index < intervals {
        double weight = 2.0;
        if index % 2 != 0 {
            weight = 4.0;
        }
        total = total + weight * target(left + double(index) * step);
        index = index + 1;
    }
    return IntegrationResult(total * step / 3.0, IntegrationStatus.Success);
}
