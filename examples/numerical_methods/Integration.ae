package Integration;

from Functions import ScalarCallable;

public double trapezoid(
    ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if intervals <= 0 {
        return 0.0;
    }

    double step = (right - left) / double(intervals);
    double total = (target(left) + target(right)) / 2.0;
    int index = 1;
    while index < intervals {
        total = total + target(left + double(index) * step);
        index = index + 1;
    }
    return total * step;
}

public double simpson(
    ScalarCallable target,
    double left,
    double right,
    int intervals
) {
    if intervals <= 0 || intervals % 2 != 0 {
        return 0.0;
    }

    double step = (right - left) / double(intervals);
    double total = target(left) + target(right);
    int index = 1;
    while index < intervals {
        double weight = 2.0;
        if index % 2 != 0 {
            weight = 4.0;
        }
        total = total + weight * target(left + double(index) * step);
        index = index + 1;
    }
    return total * step / 3.0;
}
