package Results;

public enum RootStatus {
    Converged,
    MaxIterations,
    InvalidInterval,
    ZeroDerivative
}

public struct RootResult {
    double value;
    int iterations;
    RootStatus status;
}

public enum IntegrationStatus {
    Success,
    NonPositiveSubintervalCount,
    SimpsonRequiresEvenSubintervals
}

public struct IntegrationResult {
    double value;
    IntegrationStatus status;
}
