package Results;

enum RootStatus {
    Converged,
    MaxIterations,
    InvalidInterval,
    ZeroDerivative
}

public struct RootResult {
    double value;
    int iterations;
    RootStatus status;
}

enum IntegrationStatus {
    Success,
    NonPositiveSubintervalCount,
    SimpsonRequiresEvenSubintervals
}

public struct IntegrationResult {
    double value;
    IntegrationStatus status;
}

public bool isConverged(RootStatus status) {
    return status == RootStatus.Converged;
}

public bool isInvalidInterval(RootStatus status) {
    return status == RootStatus.InvalidInterval;
}

public bool isZeroDerivative(RootStatus status) {
    return status == RootStatus.ZeroDerivative;
}

public bool isIntegrationSuccess(IntegrationStatus status) {
    return status == IntegrationStatus.Success;
}

public bool isNonPositiveSubintervalCount(IntegrationStatus status) {
    return status == IntegrationStatus.NonPositiveSubintervalCount;
}

public bool isSimpsonRequiresEvenSubintervals(IntegrationStatus status) {
    return status == IntegrationStatus.SimpsonRequiresEvenSubintervals;
}
