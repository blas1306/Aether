package Results;

enum RootStatus {
    Converged,
    MaxIterations,
    InvalidInterval,
    ZeroDerivative
}

struct RootResult {
    double value;
    int iterations;
    RootStatus status;
}

enum IntegrationStatus {
    Success,
    NonPositiveSubintervalCount,
    SimpsonRequiresEvenSubintervals
}

struct IntegrationResult {
    double value;
    IntegrationStatus status;
}

bool isConverged(RootStatus status) {
    return status == RootStatus.Converged;
}

bool isInvalidInterval(RootStatus status) {
    return status == RootStatus.InvalidInterval;
}

bool isZeroDerivative(RootStatus status) {
    return status == RootStatus.ZeroDerivative;
}

bool isIntegrationSuccess(IntegrationStatus status) {
    return status == IntegrationStatus.Success;
}

bool isNonPositiveSubintervalCount(IntegrationStatus status) {
    return status == IntegrationStatus.NonPositiveSubintervalCount;
}

bool isSimpsonRequiresEvenSubintervals(IntegrationStatus status) {
    return status == IntegrationStatus.SimpsonRequiresEvenSubintervals;
}
