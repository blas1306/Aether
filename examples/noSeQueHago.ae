boolean esSimetrica(Matrix<int> A) {
    int n = A.rows;
    int m = A.columns;

    if (m != n) {
        return false;
    }

    for (int i in 1:n) {
        for (int j in 1:i) {
            if (i == j) {
                continue;
            }

            if (A[i, j] != A[j, i]) {
                return false;
            }

            println(A[i, j]);
        }
    }
    return true;
}

int main() {
    Matrix<int> A = [1, 2, 3; 2, 4, 5; 3, 5, 6];

    println("A es simetrica?: ", esSimetrica(A));

}
