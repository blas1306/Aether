import linearAlgebra as la;

struct resSVD {
    Maxtrix<double> U;
    Maxtrix<double> S;
    Maxtrix<double> V;
}

struct Spec {
    Maxtrix<double> Vap;
    Maxtrix<double> Vep;
}

struct sortIndex {
    List<double> arr;
    List<int> index;
}

sortIndex indexSort(List<double> arr) {
    List<double> copia = arr.copy();
    copia.sort(reverse = true);

    int n = length(arr);

    Map<double, Deque<int>> hash = HashMap();

    for (int i in 0:(n-1)) {
        double valor = arr[i];

        if (!hash.containsKey(valor)) {
            hash.put(valor, ArrayDeque<int>());
        }

        hash.get(valor).pushLast(i);
    }

    List<int> idx = {};

    for (int i in 0:(n-1)) {
        double valor = copia[i];
        idx.push(hash.get(valor).popFirst());
    }

    return sortIndex(copia, idx);
}

resSVD SVD(Maxtrix<double> A) {
    int m = A.rows;
    int n = A.columns;
    int r = A.rank;

    Maxtrix<double> U = la.zeros(m, m);
    Maxtrix<double> S = la.zeros(m, n);
    Maxtrix<double> V = la.zeros(n, n);

    Spec VapVep = la.eig(A'*A);
    var Vap = VapVep.Vap;
    var Vep = VapVep.Vep;

    List<double> l = {};

    for (int i in 0:(n-1)) { 
        l.push(Vap(i+1, i+1));
    }

    var lambdaSort = indexSort(l);
    var lambda = lambdaSort.arr;
    var idx = lambdaSort.index;

    for (int i in 0:n-1) {
        V[1:n, i+1] = Vep[1:n, idx[i]+1];
    }

    List<double> sigma = {};

    for (int i in 0:n-1) {
        sigma.push(sqrt(max(lambda[i], 0)));
    }

    for (int i in 0:min(m, n)-1) {
        S[i+1, i+1] = sigma[i];
    }

    for (int i in 0:r-1) {
        U[1:m, i+1] = (1/sigma[i])*(A*V[1:n, i+1]);
    }

    if (r < m) {
        U_r = U(1:m, 1:r);
        U_new = la.N(U_r');
        U = [U_r, U_new];
    }

    return resSVD(U, S, V);
}