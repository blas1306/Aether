public double doble(double x) {
    return 2*x;
}

println(doble(3.0));

public int fib(int n) {
    if (n <= 1) {
        return n;
    }

    return fib(n-1) + fib(n-2);
}

println("fib($4$) = $fib(4)$");

public double sumatoria(int a) {
    double suma = 0.0;

    if (a < 0) {
        println("Suma invalida");
    } else {
        suma = a*(a+1)/2;
    }

    return suma;
}

public double sumatoriav2(int a2) {
    double sumav2 = 0.0;

    if (a2 > 0) {
        int i = 1;
        while (i < a2 + 1) {
            sumav2 = sumav2 + i;
            i = i + 1;
        }
    }

    return sumav2;
}

public int sumaCuadrados(int n) {
    int suma = 0;

    for (i in 1:n) {
        suma += i^2;
    }

    return suma;
}

f(x) = sin(x);

println("Prueba 1: ", sumatoria(5));
println("Prueba 2: ", sumatoriav2(5));
println("Prueba 3: ", sumaCuadrados(6));
println("Prueba 4: ", f(0));

