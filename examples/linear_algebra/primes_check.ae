import Math.LinearAlgebra
import Plots

f(x) = x^2 + 1;
println("f(4) = ", f(4));

public boolean EsPrimo(int p) {
    if p <= 1 {
        println("No existen numeros primos menores que 2");
    }

    if p == 2 {
        return true;
    }

    if p > 2 {
        for i in 2:int(sqrt(p)) {
            if (p % i == 0) {
                return false;
            }
        }
    }

    return true;
}

EsPrimo(1);
println(EsPrimo(2));
println(EsPrimo(5));
println(EsPrimo(57));

A = [3 2; 1 0; 0 0];
b = [5; 3; 0];

m, n = size(A);
x = A \ b;

println("Filas de A: ", m);
println("Columnas de A: ", n);
println("x = ", x);
println("N(A) = ", N(A));
println("R(A) = ", R(A));

public double triple(double y) {
    return 3*y;
}

println(triple(3));