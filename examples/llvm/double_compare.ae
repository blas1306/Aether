boolean ordered(double a, double b) {
    if (a < b) {
        if (a <= b) {
            if (b > a) {
                if (b >= a) {
                    if (a == a) {
                        if (a != b) {
                            return true;
                        } else {
                            return false;
                        }
                    } else {
                        return false;
                    }
                } else {
                    return false;
                }
            } else {
                return false;
            }
        } else {
            return false;
        }
    } else {
        return false;
    }
}

int main() {
    if (ordered(1.0, 2.0)) {
        return 19;
    }

    return 1;
}
