import Math as M

int GenPrimos(int n) {
    int suma1 = 0;

    for (int i in 1:(2^n)) {
        int suma2 = 0;

        for (int j in 1:i) {
            if (((M.factorial(j - 1) + 1) % j) == 0) {
                suma2 = suma2 + 1;
            }
        }

        double base = double(n) / double(suma2);
        double exponent = 1.0 / double(n);

        suma1 += int(base^exponent);
    }

    return 1 + suma1;
}

for (int i in 1:3) {
    println(GenPrimos(i));
}