int GenPrimos(int n) {
    int suma1 = 0;

    for i in 1:int(2^n) {
        int suma2 = 0;

        for j in 1:i {
            if ((Math.factorial(j - 1) + 1) % j) == 0 {
                suma2 = suma2 + 1;
            }
        }

        suma1 = suma1 + int((n/suma2)^(1/n));
    }

    int p = 1 + suma1;
    return p;
}

int main() {
    println(GenPrimos(2));
    println(GenPrimos(5));
    println(GenPrimos(10));
}