import Math

int GenPrimos(int n) {
    suma1 = 0;

    for i in 1:(2^n) {
        suma2 = 0;

        for j in 1:i {
            if (((j - 1)! + 1) % j) == 0 {
                suma2 = suma2 + 1;
            }
        }

        suma1 = suma1 + floor((n/suma2)^(1/n));
    }

    p = 1 + suma1;
    return p;
}

while true {
    int n = input("Ingrese un numero: ");

    if n <= 0 {
        println("Pero que pelotudo que sos, pone un numero natural positivo");
    } else {
        pn = GenPrimos(n);
        println("p_{$n$} = ", pn);
    }
}