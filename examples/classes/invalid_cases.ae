class Counter {
    int value;

    void secretIncrement() {
        value = value + 1;
    }

    public void increment() {
        secretIncrement();
    }

    public int getValue() {
        return value;
    }
}

Counter counter = Counter(2);
counter.increment();
println(counter.getValue());

// println(counter.value);          // invalid: value is private
// counter.secretIncrement();       // invalid: method is private
