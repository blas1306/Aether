double nchoosek(int n, int k) {
    if (k < 0 || k > n) {
        return 0.0;
    }

    if (k > n - k) {
        k = n - k;
    }

    double resultado = 1.0;

    for (int i in 1:k) {
        resultado = resultado * (n - i + 1) / i;
    }

    return resultado;
}

double n_esima_derivada(
    Function<(double), double> f,
    double x,
    int n,
    double h
) {
    double derivada = 0.0;
    double denominador = 1.0;

    for (int i in 1:n) {
        denominador = denominador * h;
    }

    double sign = 1.0;

    for (int k in 0:n) {
        double desplazamiento = (n / 2.0 - k) * h;

        derivada = derivada
            + sign * nchoosek(n, k) * f(x + desplazamiento);

        sign = -sign;
    }

    return derivada / denominador;
}

double f(double x) {
    return x * x * x;
}

int main() {
    double derivadaSegunda = n_esima_derivada(f, 2.0, 2, 0.0001);
    println("f''(2) = ", derivadaSegunda);
    println("Error = ", abs(derivadaSegunda - 12));

    return 0;
}