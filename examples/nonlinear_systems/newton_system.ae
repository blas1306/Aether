import Math.LinearAlgebra as LA
import Plots as pl

Vector<double, Column> F(Vector<double, Column> x) {
    Vector<double, Column> F = [x[1]^2 + x[2] - 11, x[1] + x[2]^2 - 7];
    return F;
}

Matrix<double> JF(Vector<double, Column> x) {
    Matrix<double> JF = [2*x[1], 1; 1, 2*x[2]];
    return JF;
}

Vector<double, Column> x0 = [1, 1];
double tol = 1e-8;
int maxiter = 100;

Vector<double, Column> xn = x0;
double res = LA.norm(F(xn));
int iter = 0;

while (res > tol && iter < maxiter) {
    z = JF(xn) \ (-F(xn));
    xn = xn + z;
    res = LA.norm(F(xn));
    iter += 1;
}

println("xn = ", xn);
println("res = ", res);
println("iter = ", iter);

double f1(double x) {
    f1 = 11 - x^2;
    return f1;
}

double f2(double x) {
    f2 = sqrt(7 - x);
    return f2;
}

pl.grid(true);
pl.plot(f1, -5, 5);