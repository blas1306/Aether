import Math.LinearAlgebra

Vector<double, Column> F(Vector<double, Column> x) {
    Vector<double, Column> F = [x[1]^2 + x[2]^2 - 4, exp(x[1]) + x[2] - 1];
    return F;
}

Matrix<double> JF(Vector<double, Column> x) {
    Matrix<double> JF = [2*x[1], 2*x[2]; exp(x[1]), 1];
    return JF;
}

Vector<double, Column> x0 = [2, 0];
double tol = 1e-8;
int maxiter = 100;

Vector<double, Column> xn = x0;
double res = Math.LinearAlgebra.norm(F(xn));
int iter = 0;

while (res > tol && iter < maxiter) {
    z = JF(xn) \ (-F(xn));
    xn = xn + z;
    res = Math.LinearAlgebra.norm(F(xn));
    iter += 1;
}

println("xn = ", xn);
println("res = ", res);
println("iter = ", iter);