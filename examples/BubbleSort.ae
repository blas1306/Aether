private void swap(List<int> lista, int i, int j) {
    int aux = lista[i];
    lista[i] = lista[j];
    lista[j] = aux;
}

public List<int> BubbleSort(List<int> lista) {
    int n = length(lista);
    boolean huboIntercambio = true;

    for pasada in 0:(n-2) {
        huboIntercambio = false;

        for j in 0:(n-2-pasada) {
            if lista[j] > lista[j+1] {
                swap(lista, j, j + 1);
                huboIntercambio = true;
            }
        }
    }

    return lista;
}

List<int> listaBubble = {10, 3, 5, 1, 8, 2};
println("BubbleSort: ", BubbleSort(listaBubble));
