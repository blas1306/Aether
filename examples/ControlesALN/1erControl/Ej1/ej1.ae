// Control 1 ALN

import Plots as plt;
from Biseccion import Biseccion;

// Ej 1
// 1a)

f(double x) = ln(1 - x + x^3);
df(double x) = (-1 + 3*x^2)/(1 - x + x^3);

plt.grid(true);
plt.plot(f, 0, 1);
plt.plot!(df, 0, 1);
plt.legend("f(x)", "f'(x)");

// 1c)

double x = Biseccion(df, 0, 1, 1e-10);

println("Punto estacionario de f(x): ", x);
println("residuo: ", abs(df(x)));
