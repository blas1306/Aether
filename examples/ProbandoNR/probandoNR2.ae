struct NewtonResultado {
    double raiz;
    double res;
    int iter;
}

NewtonResultado NR2(Function<(double), double> f, Function<(double), double> df, double x0, double tol, int maxiter) {
    double x = x0;
    double res = abs(f(x));
    int iter = 0;

    while ((res > tol) && (iter < maxiter)) {
        x = x - f(x)/df(x);
        res = abs(f(x));
        iter = iter + 1;
    }

    return NewtonResultado(x, res, iter);
}

double f(double x) {
    return x*exp(x) - 1;
}

double df(double x) {
    return exp(x) + x*exp(x);
}

int main() {
    NewtonResultado nr = NR2(f, df, 1, 1e-8, 100);

    println("x = ");
    println(nr.raiz);
    println("res = ");
    println(nr.res);
    println("iter = ");
    println(nr.iter);

    return 0;
}
