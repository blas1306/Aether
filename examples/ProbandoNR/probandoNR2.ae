struct NewtonResultado {
    double raiz;
    double res;
    int iter;
}

NewtonResultado NR2(Function<(double), double> f, Function<(double), double> df, double x0, double tol, int maxiter) {
    double x = x0;
    double res = abs(f(x));
    int iter = 0;

    while ((res > tol) && (iter < maxiter)) {
        x = x - f(x)/df(x);
        res = abs(f(x));
        iter += 1;
    }

    return NewtonResultado(x, res, iter);
}

double f(double x) {
    double f = x*exp(x) - 1;
    return f;
}

double df(double x) {
    double df = exp(x) + x*exp(x);
    return df;
}

NewtonResultado nr = NR2(f, df, 1, 1e-8, 100);

println("x = ", nr.raiz);
println("res = ", nr.res);
println("iter = ", nr.iter);

