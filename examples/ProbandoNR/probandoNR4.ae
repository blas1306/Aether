struct NewtonResultado {
    double raiz;
    double res;
    int iter;
}

NewtonResultado NR2(Function<(float), float> f, Function<(float), float> df, float x0, double tol, int maxiter) {
    float x = x0;
    float res = abs(f(x));
    int iter = 0;

    while ((res > tol) && (iter < maxiter)) {
        x = x - f(x)/df(x);
        res = abs(f(x));
        iter += 1;
    }

    return NewtonResultado(x, res, iter);
}

int main() {
    float f = input("Ingrese la funcion f(x): ");
    float df = input("Ingrese la funcion df(x): ");

    NewtonResultado nr = NR2(f, df, 1, 1e-8, 100);

    println("x = ", nr.raiz);
    println("res = ", nr.res);
    println("iter = ", nr.iter);
}

