struct NewtonResultado {
    double raiz;
    double res;
    int iter;
}

NewtonResultado NR4(
    Function<(double), double> f,
    Function<(double), double> df,
    Function<(double), double> ddf,
    double x0,
    double tol,
    int maxiter)
    {
    double x = x0;
    double res = abs(f(x));
    int iter = 0;

    while ((res > tol) && (iter < maxiter)) {
        x = x - (f(x)*df(x))/(abs(df(x))*abs(df(x)) - f(x)*ddf(x));
        res = abs(f(x));
        iter = iter + 1;
    }

    return NewtonResultado(x, res, iter);
}

double f(double x) {
    return x*exp(x) - 1;
}

double df(double x) {
    return exp(x) + x*exp(x);
}

double ddf(double x) {
    return 2*exp(x) + x*exp(x);
}

int main() {
    NewtonResultado nr = NR4(f, df, ddf, 1, 1e-8, 100);

    println("x = ${nr.raiz}");
    println("res = ${nr.res}");
    println("iter = ${nr.iter}");

    return 0;
}
